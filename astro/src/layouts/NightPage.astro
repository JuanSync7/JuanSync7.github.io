---
import PaperLayout from './PaperLayout.astro';

/** A page of the site: the paper system (notepad by day, blackboard by night) plus Astro's
 *  router, so moving between pages crossfades and shared elements (a post card's cover) travel.
 *  The name is kept from the night era so the pages that use it need no change; the figure
 *  bench uses NightLayout alone. */
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
---

<PaperLayout {...Astro.props}>
  <slot name="head" slot="head" />
  <slot />
</PaperLayout>
