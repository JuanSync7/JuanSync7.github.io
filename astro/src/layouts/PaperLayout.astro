---
import { ViewTransitions } from 'astro:transitions';
import '../styles/tokens/index.css';
import '../styles/night.css';
import '../styles/paper.css';

/** A page on the paper system: notepad by day, blackboard by night. Follows the visitor's
 *  setting until they pick a theme with the nav toggle; the choice is kept per browser. */
interface Props {
  title: string;
  description?: string;
  /** Keep the page out of search results. */
  noindex?: boolean;
}

const { title, description = 'Juan Kok: Senior Design & AI Engineer. AI platform, agents and governance.', noindex = false } = Astro.props;

const THEME = `try{var t=localStorage.getItem('pp-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}`;
---

<!doctype html>
<html lang="en" class="paper">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <title>{title}</title>
    <slot name="head" />
    <script is:inline set:html={THEME} />
    <ViewTransitions />
  </head>
  <body class="paper night">
    <!-- Figures are drawn in the night palette: near-black ground, light lines, teal signal. These
         two filters (see --pp-figure-filter) recolour them so a figure's ground, and the faces it
         fills with that ground to hide what is behind, match the page exactly: cream (F3ECDF) by
         day, gunmetal (16191E) by night, with the signal orange in place of the teal. -->
    <svg class="pp-figure-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <filter id="pp-figure-day" color-interpolation-filters="sRGB">
        <feColorMatrix type="matrix" values="-1.0739 0.5402 -0.4044 0 0.9845 -0.1175 -0.7401 -0.0366 0 0.9537 0.2395 -1.1569 0.1001 0 0.8995 0 0 0 1 0" />
      </filter>
      <filter id="pp-figure-night" color-interpolation-filters="sRGB">
        <feColorMatrix type="matrix" values="-0.1987 1.2545 -0.0859 0 0.0564 0.7252 -0.0535 0.2701 0 0.0671 1.0212 -0.5228 0.3846 0 0.0879 0 0 0 1 0" />
      </filter>
    </svg>
    <div class="pp-page">
      <slot />
    </div>
  </body>
</html>
