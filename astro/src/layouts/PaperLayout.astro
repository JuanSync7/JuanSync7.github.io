---
import { figureMatrix, worldContrast } from '../styles/theme/figure-filters';
import { ViewTransitions } from 'astro:transitions';
import '../styles/tokens/index.css';
import '../styles/night.css';
import '../styles/paper.css';

/** A page on the paper system: notepad by day, blackboard by night. Follows the visitor's
 *  setting until they pick a theme with the nav toggle; the choice is kept per browser. */
interface Props {
  title: string;
  description?: string;
  /** Keep the page out of search results. */
  noindex?: boolean;
}

const { title, description = 'Juan Kok: Senior Design & AI Engineer. AI platform, agents and governance.', noindex = false } = Astro.props;

const THEME = `try{var t=localStorage.getItem('pp-theme');if(t==='light'||t==='dark')document.documentElement.dataset.theme=t}catch(e){}`;
const dayMatrix = figureMatrix(0);
const nightMatrix = figureMatrix(1);
const dayWorld = worldContrast(0);
const nightWorld = worldContrast(1);
---

<!doctype html>
<html lang="en" class="paper">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : null}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <slot name="head" />
    <script is:inline set:html={THEME} />
    <ViewTransitions />
  </head>
  <body class="paper night">
    <!-- Figures are drawn in the night palette: near-black ground, light lines, teal signal. These
         two filters (see --pp-figure-filter) recolour them so a figure's ground, and the faces it
         fills with that ground to hide what is behind, match the page exactly: cream (F3ECDF) by
         day, gunmetal (16191E) by night, with the signal orange in place of the teal. -->
    <svg class="pp-figure-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <filter id="pp-figure-day" color-interpolation-filters="sRGB">
        <feColorMatrix type="matrix" values={dayMatrix} />
      </filter>
      <filter id="pp-figure-night" color-interpolation-filters="sRGB">
        <feColorMatrix type="matrix" values={nightMatrix} />
      </filter>
      <filter id="pp-world-night" color-interpolation-filters="sRGB">
        <feColorMatrix type="matrix" values={nightMatrix} />
        <feComponentTransfer><feFuncR type="linear" slope={nightWorld.slope} intercept={nightWorld.intercepts[0]} /><feFuncG type="linear" slope={nightWorld.slope} intercept={nightWorld.intercepts[1]} /><feFuncB type="linear" slope={nightWorld.slope} intercept={nightWorld.intercepts[2]} /></feComponentTransfer>
      </filter>
      <filter id="pp-world-day" color-interpolation-filters="sRGB">
        <feColorMatrix type="matrix" values={dayMatrix} />
        <feComponentTransfer><feFuncR type="linear" slope={dayWorld.slope} intercept={dayWorld.intercepts[0]} /><feFuncG type="linear" slope={dayWorld.slope} intercept={dayWorld.intercepts[1]} /><feFuncB type="linear" slope={dayWorld.slope} intercept={dayWorld.intercepts[2]} /></feComponentTransfer>
      </filter>
    </svg>
    <div class="pp-page">
      <slot />
    </div>
  </body>
</html>
