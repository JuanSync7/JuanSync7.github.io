---
import NightPage from './NightPage.astro';
import NightNav from '../components/layout/NightNav.astro';
import NightFooter from '../components/layout/NightFooter.astro';
import '../components/trackers/_chrome.css';
import '../components/trackers/tracker-night.css';

/** A tracker page on the night system: the site's nav and footer, a row linking the three
 *  trackers and the field guides, then the page. The dashboards keep their own skin
 *  (tracker-skin.css), its colours and fonts taken from the night tokens (tracker-night.css). */
interface Props {
  title?: string;
  /** The tracker this page belongs to. */
  active?: string;
}

const { title = 'Trackers · Juan Kok', active = '' } = Astro.props;
const links = [
  { id: 'engines', href: '/trackers/inference-engines', label: 'engines' },
  { id: 'models', href: '/trackers/frontier-models', label: 'models' },
  { id: 'silicon', href: '/trackers/inference-silicon', label: 'silicon' },
];
---

<NightPage title={title}>
  <NightNav current="writing" />
  <main class="wrap">
    <nav class="tnav" aria-label="Trackers">
      <a class="tnav-home" href="/trackers/">// trackers</a>
      {links.map((l) => (
        <a href={l.href} aria-current={active === l.id ? 'page' : undefined}>{l.label}</a>
      ))}
      <a class="tnav-learn" href="/learn/">field guides →</a>
    </nav>
    <slot />
  </main>
  <NightFooter />
</NightPage>
