---
import SectionHead from '../ui/SectionHead.astro';
import { CASES } from '../../data/home';
---

<section id="cases" class="nt-wrap nt-section cases">
  <SectionHead label={CASES.label} title={CASES.title} lead={CASES.body} />
  <div class="grid">
    {CASES.items.map((c, i) => (
      <article class="case">
        <span class="idx">case {String(i + 1).padStart(2, '0')}</span>
        <h3>{c.title}</h3>
        <div class="beat">
          <span class="beat-label">what I noticed</span>
          <p>{c.noticed}</p>
        </div>
        <div class="beat">
          <span class="beat-label did">what I did</span>
          <p>{c.did}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .cases {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-12);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--hf-space-4);
  }

  .case {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-5);
    padding: var(--hf-space-6);
    border: 1px solid var(--nt-line);
    border-radius: var(--hf-radius-xl);
    background: var(--nt-panel);
  }

  .idx,
  .beat-label {
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-caption);
    color: var(--nt-ink-faint);
  }

  .beat-label.did {
    color: var(--nt-signal);
  }

  h3 {
    font-size: var(--nt-fs-h4);
    line-height: var(--nt-lh-heading);
    letter-spacing: var(--nt-tracking-heading);
  }

  .beat {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-2);
    padding-top: var(--hf-space-4);
    border-top: 1px solid var(--nt-rule);
  }

  p {
    font-size: var(--nt-fs-ui);
    color: var(--nt-ink-soft);
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
