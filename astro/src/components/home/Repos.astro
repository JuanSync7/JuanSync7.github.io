---
import SectionHead from '../ui/SectionHead.astro';
import { REPOS } from '../../data/repos';

const [flagship, ...rest] = REPOS.items;
---

<section id="work" class="nt-wrap nt-section repos">
  <div class="top">
    <SectionHead label={REPOS.label} title={REPOS.title} />
    <a class="profile" href={REPOS.profile.href}>{REPOS.profile.label} ↗</a>
  </div>

  {flagship ? (
    <article class="card flag">
      <div class="flag-copy">
        <div class="tags">
          <span class="kind">{flagship.kind}</span>
          <span class="vis">{flagship.visibility} repo</span>
        </div>
        <h3>{flagship.name}</h3>
        {flagship.body.map((p) => <p>{p}</p>)}
      </div>
      {'facts' in flagship && flagship.facts ? (
        <dl class="facts">
          {flagship.facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      ) : null}
    </article>
  ) : null}

  <div class="grid">
    {rest.map((r) => (
      <article class="card">
        <div class="tags">
          <span class="kind">{r.kind}</span>
          <span class="vis">{r.visibility}</span>
        </div>
        <h3>{'url' in r && r.url ? <a href={r.url}>{r.name} ↗</a> : r.name}</h3>
        {r.body.map((p) => <p>{p}</p>)}
        {'stack' in r && r.stack ? <span class="stack">{r.stack}</span> : null}
      </article>
    ))}
  </div>
</section>

<style>
  .repos {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-8);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--hf-space-4);
    margin-bottom: var(--hf-space-4);
  }

  .profile {
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-meta);
    color: var(--nt-ink-muted);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-3);
    padding: var(--hf-space-6);
    border: 1px solid var(--nt-line);
    border-radius: var(--hf-radius-xl);
    background: var(--nt-panel);
    transition: border-color 0.2s ease;
  }

  .card:hover {
    border-color: var(--nt-line-3);
  }

  .flag {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--hf-space-10);
    padding: var(--hf-space-8);
    border-color: var(--nt-signal-line);
    background: var(--nt-panel-signal);
  }

  .flag-copy {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-4);
  }

  .tags {
    display: flex;
    gap: var(--hf-space-3);
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-caption);
  }

  .kind {
    color: var(--nt-signal);
  }

  .vis {
    color: var(--nt-ink-faint);
  }

  h3 {
    font-size: var(--nt-fs-h4);
    letter-spacing: var(--nt-tracking-heading);
  }

  .flag h3 {
    font-size: var(--nt-fs-h3);
  }

  p {
    font-size: var(--nt-fs-small);
    color: var(--nt-ink-soft);
  }

  .facts {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .facts div {
    display: flex;
    justify-content: space-between;
    gap: var(--hf-space-4);
    padding: var(--hf-space-3) 0;
    border-top: 1px solid var(--nt-signal-line);
  }

  dt {
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-caption);
    color: var(--nt-ink-muted);
  }

  dd {
    margin: 0;
    font-size: var(--nt-fs-small);
    color: var(--nt-ink-strong);
    text-align: right;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--hf-space-4);
  }

  .stack {
    margin-top: auto;
    padding-top: var(--hf-space-3);
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-caption);
    color: var(--nt-ink-faint);
  }

  @media (max-width: 960px) {
    .flag {
      grid-template-columns: minmax(0, 1fr);
    }

    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 640px) and (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
