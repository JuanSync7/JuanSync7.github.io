---
// The paint-mixing splat behind the mark: irregular blobs, diagonal brushstrokes fanning out of
// them and a few satellite droplets, drawn three times (warped, sharp-ish, soft) like the design
// board. Laid out once from a seed so a build is repeatable. Colours are theme slots, --pp-sp-1..7.
const SLOTS = 7;
const SIZE = 440;
const MID = SIZE / 2;

const rng = (start: number) => {
  let a = start;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
};

const between = (r: () => number, lo: number, hi: number): number => lo + Math.floor(r() * (hi - lo + 1));
const slot = (r: () => number): number => 1 + Math.floor(r() * SLOTS);

interface Piece {
  css: string;
}

const lay = (seed: number): Piece[] => {
  const r = rng(seed);
  const pieces: Piece[] = [];
  for (let i = 0; i < 7; i++) {
    const a = slot(r);
    const b = slot(r);
    const d = between(r, 120, 300);
    const h = Math.round(d * (0.35 + r() * 0.65));
    const cx = MID + between(r, -40, 40);
    const cy = MID + between(r, -40, 40);
    const radius = Array.from({ length: 8 }, () => `${between(r, 20, 80)}%`);
    const corners = `${radius.slice(0, 4).join(' ')} / ${radius.slice(4).join(' ')}`;
    pieces.push({
      css: `left:${cx - d / 2}px;top:${cy - h / 2}px;width:${d}px;height:${h}px;border-radius:${corners};opacity:${(0.7 + r() * 0.3).toFixed(2)};background:radial-gradient(circle at ${between(r, 15, 85)}% ${between(r, 15, 85)}%, var(--pp-sp-${a}) 0%, var(--pp-sp-${b}) 55%, transparent 100%);transform:rotate(${between(r, 0, 180)}deg)`,
    });
  }
  for (let i = 0; i < 11; i++) {
    const s = slot(r);
    const len = between(r, 170, 430);
    const thick = between(r, 8, 34);
    const angle = Math.round(-38 + (r() * 32 - 16));
    const cx = MID + between(r, -60, 60);
    const cy = MID + between(r, -60, 60);
    const shift = (r() < 0.5 ? -1 : 1) * between(r, 0, 40);
    pieces.push({
      css: `left:${cx - len / 2}px;top:${cy - thick / 2}px;width:${len}px;height:${thick}px;border-radius:50%;background:linear-gradient(90deg, transparent 0%, var(--pp-sp-${s}) ${between(r, 15, 35)}%, var(--pp-sp-${s}) ${between(r, 55, 80)}%, transparent 100%);transform:rotate(${angle}deg) translateY(${shift}px)`,
    });
  }
  for (let i = 0; i < 5; i++) {
    const s = slot(r);
    const angle = r() * Math.PI;
    const reach = between(r, 130, 230);
    const d = between(r, 12, 38);
    for (const sign of [1, -1]) {
      const x = Math.round(MID + sign * reach * Math.cos(angle) - d / 2);
      const y = Math.round(MID + sign * reach * Math.sin(angle) - d / 2);
      pieces.push({
        css: `left:${x}px;top:${y}px;width:${d}px;height:${d}px;border-radius:50%;background:var(--pp-sp-${s});opacity:0.8`,
      });
    }
  }
  return pieces;
};

const layers = [
  { seed: 5, cls: 'warp' },
  { seed: 23, cls: 'sharp' },
  { seed: 5, cls: 'soft' },
].map((l) => ({ ...l, pieces: lay(l.seed) }));
---

<div class="splat" aria-hidden="true">
  {layers.map((l) => (
    <div class={`layer ${l.cls}`}>
      <div class="art">
        {l.pieces.map((p) => <span style={p.css}></span>)}
      </div>
    </div>
  ))}
</div>

<style>
  .splat {
    position: absolute;
    inset: 0;
  }

  .layer {
    position: absolute;
    inset: -70px -90px;
  }

  .art {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 440px;
    height: 440px;
    margin: -220px 0 0 -220px;
    transform: scale(1.02);
  }

  .art span {
    position: absolute;
  }

  .warp {
    filter: url('#pp-chalk') blur(11px);
    opacity: 0.6;
  }

  .sharp {
    filter: blur(6px);
    opacity: 0.3;
  }

  .sharp .art {
    filter: url('#pp-chalk');
  }

  .soft {
    filter: blur(30px);
    opacity: 0.55;
  }

  .soft .art {
    filter: url('#pp-chalk');
  }
</style>
