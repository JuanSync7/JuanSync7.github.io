---
// The backdrop behind the mark: a few bold dry-brush strokes, the same brush that paints the theme
// change. Each stroke is a flat colour cut by the brush mask, so its ragged ends and bristle streaks
// come from the mask. Colours are tokens; the strokes paint on once, left to right.
const strokes = [
  { cls: 'a', w: 400, h: 96, x: -215, y: -185, r: -14 },
  { cls: 'b', w: 330, h: 80, x: -150, y: 150, r: -14 },
];
---

<div class="splat" aria-hidden="true">
  {strokes.map((s, i) => (
    <span
      class={`stroke ${s.cls}`}
      style={`--w:${s.w}px;--h:${s.h}px;--x:${s.x}px;--y:${s.y}px;--r:${s.r}deg;--i:${i}`}
    ></span>
  ))}
</div>

<style>
  .splat {
    position: absolute;
    inset: 0;
  }

  .stroke {
    position: absolute;
    left: calc(50% + var(--x));
    top: calc(50% + var(--y));
    width: var(--w);
    height: var(--h);
    transform: rotate(var(--r));
    transform-origin: left center;
    mask-image: url('/brush-stroke.svg');
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
    animation: pp-paint-on var(--pp-dur-brush) var(--pp-ease-brush) both;
    animation-delay: calc(var(--i) * var(--pp-dur-step) * 3);
  }

  .a {
    background: var(--pp-signal);
    opacity: 0.85;
  }

  .b {
    background: var(--pp-outline);
    opacity: 0.8;
  }

  @keyframes pp-paint-on {
    from {
      clip-path: inset(0 100% 0 0);
    }

    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stroke {
      animation: none;
    }
  }
</style>
