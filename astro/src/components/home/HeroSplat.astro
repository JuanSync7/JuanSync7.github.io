---
// The backdrop behind the mark: a few dry-brush strokes in the outline colour, painted one after
// another with the same brush that paints the theme change. Each stroke is a flat colour cut by
// the brush mask, so its ragged ends and bristle streaks come from the mask.
const rng = (start: number) => {
  let a = start;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
};

const next = rng(31);
const range = (lo: number, hi: number): number => lo + next() * (hi - lo);

// Scattered, not stacked: each stroke has its own length, thickness, angle, strength and heading
// (flipped ones fray on the left), centred loosely on the mark.
const strokes = Array.from({ length: 11 }, () => {
  const w = Math.round(range(150, 400));
  const reach = Math.max(0, 215 - w / 2);
  return {
    w,
    h: Math.round(range(34, 112)),
    x: Math.round(range(-reach, reach)),
    y: Math.round(range(-200, 200)),
    r: Math.round(range(-38, 30)),
    flip: next() < 0.4 ? -1 : 1,
    o: Number(range(0.35, 0.9).toFixed(2)),
    d: Math.round(next() * 6),
  };
});
---

<div class="splat" aria-hidden="true">
  {strokes.map((s) => (
    <span
      class="stroke"
      style={`--w:${s.w}px;--h:${s.h}px;--x:${s.x}px;--y:${s.y}px;--r:${s.r}deg;--o:${s.o};--f:${s.flip};--d:${s.d}`}
    ></span>
  ))}
</div>

<style>
  .splat {
    position: absolute;
    inset: 0;
  }

  .stroke {
    position: absolute;
    left: calc(50% + var(--x) - var(--w) / 2);
    top: calc(50% + var(--y) - var(--h) / 2);
    width: var(--w);
    height: var(--h);
    transform: rotate(var(--r)) scaleX(var(--f));
    background: var(--pp-outline);
    opacity: var(--o);
    mask-image: url('/brush-stroke.svg');
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
    animation: pp-paint-on var(--pp-dur-brush) var(--pp-ease-brush) both;
    animation-delay: calc(var(--d) * var(--pp-dur-step) * 2);
  }

  @keyframes pp-paint-on {
    from {
      clip-path: inset(0 100% 0 0);
    }

    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stroke {
      animation: none;
    }
  }
</style>
