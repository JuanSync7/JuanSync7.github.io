---
import PaperHead from './PaperHead.astro';
import FigureCanvas from '../ui/FigureCanvas';
import { EXPERIENCE, EXPERIENCE_TILES, THINKING } from '../../data/home';
import { REPOS } from '../../data/repos';

// A tile's evidence: its public repo on GitHub, or the write-up on /about when the repo is private.
const evidence = (name: string | null): { name: string; href: string; out: boolean } | null => {
  const repo = REPOS.items.find((r) => r.name === name);
  if (!repo) return null;
  const url = 'url' in repo ? repo.url : undefined;
  return url ? { name: repo.name, href: url, out: true } : { name: repo.name, href: '/about/#repos', out: false };
};
const parts = [
  { label: 'stack', items: THINKING.stack },
  { label: 'domain', items: THINKING.domain },
];
---

<section id="work" class="pp-section">
  <div class="pp-wrap">
    <PaperHead note="chips first, then the AI platform" label={EXPERIENCE.label} title={EXPERIENCE.title} />
    <div class="grid">
      {EXPERIENCE_TILES.map((t) => (
        <article class="tile">
          <div class="icon"><FigureCanvas id="experience-icon" data={{ kind: t.kind }} label={t.title} ahead="150% 0px" client:idle /></div>
          <p class="pp-label tag">{t.tag}</p>
          <h3 class="pp-title">{t.title}</h3>
          <p class="pp-small cap">{t.caption}</p>
          {(() => {
            const e = evidence(t.repo);
            return e ? (
              <a class="pp-label repo" href={e.href}>repo · {e.name}{e.out ? ' ↗' : ''}</a>
            ) : null;
          })()}
        </article>
      ))}
    </div>
    <dl class="parts">
      {parts.map((p) => (
        <div class="part">
          <dt class="pp-label">{p.label}</dt>
          <dd class="pp-label list">{p.items.join(' · ')}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--pp-rule);
  }

  /* Transparent cards, divided only by hairlines: a rule under each row and between columns. */
  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-2);
    padding: var(--hf-space-6);
    border-bottom: 1px solid var(--pp-rule);
  }

  .tile:not(:nth-child(3n + 1)) {
    border-left: 1px solid var(--pp-rule);
  }

  .icon {
    aspect-ratio: 1.3;
    margin-bottom: var(--hf-space-3);
  }

  .tag {
    margin: 0;
  }

  .tile :global(.pp-title),
  .cap {
    margin: 0;
  }

  .cap {
    color: var(--pp-ink-muted);
    max-width: 44ch;
  }

  .repo {
    display: inline-flex;
    align-items: center;
    min-height: var(--nt-hit);
    margin-top: auto;
    color: var(--pp-signal-text);
  }

  /* The tools, as a parts list on a drawing: a label and a run of names, no chips. */
  .parts {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-3);
    margin: var(--hf-space-6) 0 0;
  }

  .part {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hf-space-1) var(--hf-space-6);
  }

  .part dt {
    flex: 0 0 var(--hf-space-20);
    margin: 0;
  }

  .list {
    margin: 0;
    color: var(--pp-ink-muted);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tile:not(:nth-child(3n + 1)) {
      border-left: 0;
    }

    .tile:nth-child(2n) {
      border-left: 1px solid var(--pp-rule);
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .tile:nth-child(n) {
      border-left: 0;
    }
  }
</style>
