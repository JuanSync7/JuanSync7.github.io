---
import PaperHead from './PaperHead.astro';
import { EXPERIENCE } from '../../data/home';
---

<section id="experience" class="pp-section">
  <div class="pp-wrap">
    <PaperHead note="chips first, then the AI platform" label={EXPERIENCE.label} title={EXPERIENCE.title} />
    <div class="list">
      {EXPERIENCE.roles.map((r) => (
        <article class="pp-row role">
          <div class="head">
            <h3 class="pp-title">{r.title}</h3>
            <p class="pp-label">{r.org}{r.place ? ` · ${r.place}` : ''}</p>
          </div>
          <div class="body">
            <p class="pp-body">{r.summary}</p>
            {r.points ? (
              <dl>
                {r.points.map((p) => (
                  <div>
                    <dt class="pp-label">{p.tag}</dt>
                    <dd class="pp-small">{p.text}</dd>
                  </div>
                ))}
              </dl>
            ) : null}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .list {
    border-bottom: 1px solid var(--pp-rule);
  }

  .role {
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--hf-space-3) var(--hf-space-8);
    padding: var(--hf-space-6) 0;
  }

  .head {
    flex: 0 0 250px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-1);
  }

  .body {
    flex: 1 1 280px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-3);
  }

  dl {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-2);
    margin: 0;
  }

  dd {
    margin: 0;
  }
</style>
