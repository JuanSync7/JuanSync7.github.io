---
import PaperHead from './PaperHead.astro';
import PaperAction from '../ui/PaperAction.astro';
import FigureCanvas from '../ui/FigureCanvas';
import { EXPERIENCE, EXPERIENCE_TILES, EXPERIENCE_CTA } from '../../data/home';

const [current, ...before] = EXPERIENCE.roles;
---

<section id="experience" class="pp-section">
  <div class="pp-wrap">
    <PaperHead note="chips first, then the AI platform" label={EXPERIENCE.label} title={EXPERIENCE.title} />
    {current ? (
      <p class="now pp-label">{current.title} · {current.org}{current.place ? ` · ${current.place}` : ''}</p>
    ) : null}
    <div class="grid">
      {EXPERIENCE_TILES.map((t) => (
        <article class="tile">
          <div class="icon"><FigureCanvas id="experience-icon" data={{ kind: t.kind }} label={t.title} client:visible /></div>
          <p class="pp-label tag">{t.tag}</p>
          <h3 class="pp-title">{t.title}</h3>
          <p class="pp-small cap">{t.caption}</p>
        </article>
      ))}
    </div>
    <div class="before">
      {before.map((r) => (
        <p class="step"><span class="pp-title">{r.title}</span><span class="pp-label">{r.org}</span></p>
      ))}
    </div>
    <div class="cta"><PaperAction href={EXPERIENCE_CTA.href} variant="signal">{EXPERIENCE_CTA.label}</PaperAction></div>
  </div>
</section>

<style>
  .now {
    margin: 0 0 var(--hf-space-5);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--pp-rule);
  }

  /* Transparent cards, divided only by hairlines: a rule under each row and between columns. */
  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-2);
    padding: var(--hf-space-6);
    border-bottom: 1px solid var(--pp-rule);
  }

  .tile:not(:nth-child(3n + 1)) {
    border-left: 1px solid var(--pp-rule);
  }

  .icon {
    aspect-ratio: 1.3;
    margin-bottom: var(--hf-space-3);
  }

  .tag {
    margin: 0;
  }

  .tile :global(.pp-title),
  .cap {
    margin: 0;
  }

  .cap {
    color: var(--pp-ink-muted);
    max-width: 44ch;
  }

  .before {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hf-space-3) var(--hf-space-8);
    margin-top: var(--hf-space-6);
    padding-top: var(--hf-space-5);
    border-top: 1px solid var(--pp-rule);
  }

  .step {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-1);
    margin: 0;
  }

  .cta {
    margin-top: var(--hf-space-6);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tile:not(:nth-child(3n + 1)) {
      border-left: 0;
    }

    .tile:nth-child(2n) {
      border-left: 1px solid var(--pp-rule);
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .tile:nth-child(n) {
      border-left: 0;
    }
  }
</style>
