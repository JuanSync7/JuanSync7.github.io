---
// One lab entry as a full-width row, after the featured explainer on the writing page: what it
// is on the left (meta, title, what it does, a link), its live drawing on the right with two
// notes under it. One per row, so each drawing loads as it scrolls in.
import './lab-card.css';

export interface Props {
  href: string;
  /** The mono line above the title; the first entry is set in the signal. */
  meta: readonly string[];
  title: string;
  blurb: string;
  cta: string;
  notes: readonly [string, string];
}

const { href, meta, title, blurb, cta, notes } = Astro.props;
const [kind, ...rest] = meta;
---

<article class="lab-card">
  <div class="lab-card-copy">
    <p class="lab-card-meta">
      <span class="lab-card-kind">{kind}</span>
      {rest.map((m) => <span>{m}</span>)}
    </p>
    <h3>{title}</h3>
    <p class="lab-card-blurb">{blurb}</p>
    <a class="lab-card-cta" href={href}>{cta}</a>
  </div>
  <div class="lab-card-art">
    <div class="lab-card-figure">
      <slot />
    </div>
    <p class="lab-card-notes">
      <span>{notes[0]}</span>
      <span>{notes[1]}</span>
    </p>
  </div>
</article>
