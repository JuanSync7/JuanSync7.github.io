---
/* Renders every <pre class="mermaid"> on the page as a flowchart, themed from the
   design tokens (neutral nodes + a single teal accent on `:::accent` focal nodes).
   Re-renders on the dark/light theme toggle so colours always match the page. The colours are
   read where the first diagram sits, not at the page root, so a diagram on a learn article's
   paper column takes the paper's colours on a night page. */
---
<script>

  // Colour tokens may be light-dark() pairs, which a custom property keeps unresolved; reading
  // them through a probe's `color` gives the rgb the page is actually showing.
  const readTokens = (at: Element) => {
    const s = getComputedStyle(at);
    const probe = document.createElement('span');
    at.appendChild(probe);
    const colour = (n: string) => {
      probe.style.color = `var(${n})`;
      return getComputedStyle(probe).color;
    };
    const g = (n: string) => (n === '--mono' ? s.getPropertyValue(n).trim() : colour(n));
    const out = { bg: g('--bg'), panel: g('--panel'), line: g('--line'), txt: g('--txt'), muted: g('--muted'), teal: g('--teal'), mono: g('--mono') };
    probe.remove();
    return out;
  };

  // Mermaid is 600 KB: load it only on a page that has a diagram.
  const render = async () => {
    const nodes = Array.from(document.querySelectorAll<HTMLElement>('pre.mermaid'));
    if (!nodes.length) return;
    const { default: mermaid } = await import('mermaid');
    const t = readTokens(nodes[0]);
    for (const n of nodes) {
      if (!n.dataset.src) n.dataset.src = (n.textContent || '').trim();
      else { n.innerHTML = n.dataset.src; n.removeAttribute('data-processed'); }
    }
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'loose',
      theme: 'base',
      fontFamily: t.mono || 'monospace',
      themeVariables: {
        background: t.bg, primaryColor: t.panel, secondaryColor: t.panel, tertiaryColor: t.panel,
        primaryBorderColor: t.line, primaryTextColor: t.txt, textColor: t.txt, lineColor: t.muted,
        mainBkg: t.panel, nodeBorder: t.line, clusterBkg: t.panel, titleColor: t.txt,
        edgeLabelBackground: t.bg, fontSize: '15px',
      },
      themeCSS:
        `.node rect,.node polygon,.node path,.node circle{stroke:${t.line};fill:${t.panel}}`
        + `.node .nodeLabel{color:${t.txt}}`
        + `.node.accent rect,.node.accent polygon,.node.accent path,.node.accent circle{stroke:${t.teal};stroke-width:1.7px}`
        + `.edgePaths path{stroke:${t.muted}}`
        + `.edgeLabel,.edgeLabel p{background:${t.bg};color:${t.muted}}`
        + `marker{fill:${t.muted};stroke:${t.muted}}`,
      flowchart: { curve: 'basis', htmlLabels: true, padding: 14, nodeSpacing: 46, rankSpacing: 52, useMaxWidth: true },
    });
    mermaid.run({ nodes });
  };

  void render();
  new MutationObserver(() => void render()).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
</script>
