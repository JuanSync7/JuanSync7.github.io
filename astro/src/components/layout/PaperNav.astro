---
import { NAV } from '../../data/home';
import { IDENTITY } from '../../data/site';

interface Props {
  current?: string;
}

const { current } = Astro.props;
---

<header class="pp-nav">
  <div class="pp-wrap pp-nav-inner">
    <a class="mark" href="/" aria-label={`${IDENTITY.shortName}, home`}>S<span>J</span></a>
    <button class="menu" type="button" aria-expanded="false" aria-controls="pp-menu" aria-label="Menu">
      <span class="bars" aria-hidden="true"></span>
    </button>
    <nav id="pp-menu" aria-label="Primary">
      <ul>
        {NAV.map((l) => (
          <li>
            <a href={l.href} aria-current={l.label === current ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="cv" href={IDENTITY.cvFile}>cv.pdf</a>
    <button class="theme" type="button" data-theme-toggle aria-label="Switch between light and dark theme">
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" /></svg><svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" /></svg>
    </button>
  </div>
</header>

<script is:inline>
  (function () {
    function apply() {
      var b = document.querySelector('[data-theme-toggle]');
      if (!b || b.dataset.bound) return;
      b.dataset.bound = '1';
      b.addEventListener('click', function () {
        var root = document.documentElement;
        var dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        var next = dark ? 'light' : 'dark';
        function change() {
          root.dataset.theme = next;
          try { localStorage.setItem('pp-theme', next); } catch (e) {}
        }
        if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          change();
          return;
        }
        root.classList.add('pp-theming');
        var t = document.startViewTransition(change);
        t.finished.finally(function () { root.classList.remove('pp-theming'); });
      });
    }
    function menu() {
      var m = document.querySelector('.pp-nav .menu');
      if (!m || m.dataset.bound) return;
      m.dataset.bound = '1';
      var nav = m.closest('.pp-nav');
      function set(open) {
        nav.toggleAttribute('data-open', open);
        m.setAttribute('aria-expanded', String(open));
      }
      m.addEventListener('click', function () { set(!nav.hasAttribute('data-open')); });
      nav.addEventListener('click', function (e) { if (e.target.closest('nav a')) set(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
    }
    apply();
    menu();
    document.addEventListener('astro:page-load', function () { apply(); menu(); });
    document.addEventListener('astro:after-swap', function () {
      try {
        var t = localStorage.getItem('pp-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    });
  })();
</script>

<style>
  .pp-nav {
    position: sticky;
    top: 0;
    z-index: var(--hf-z-nav);
  }

  .pp-nav-inner {
    /* The scrim sits on the content column only, so the strip and frame run up behind the gutters. */
    background: var(--nt-scrim);
    backdrop-filter: blur(12px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--hf-space-2) var(--hf-space-4);
    padding-top: var(--hf-space-4);
    padding-bottom: var(--hf-space-4);
  }

  .mark {
    font-size: var(--pp-fs-mark);
    font-weight: var(--pp-w-heading);
    letter-spacing: var(--pp-tracking-mark);
    color: var(--pp-ink-strong);
  }

  .mark span {
    color: var(--pp-signal);
  }

  nav {
    margin-left: auto;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hf-space-2) calc(var(--hf-space-6) - 2px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .cv,
  .theme {
    font-family: var(--pp-mono);
    font-size: var(--pp-fs-caption);
    font-weight: var(--pp-w-label);
    color: var(--pp-ink-muted);
  }

  nav a:hover,
  .cv:hover {
    color: var(--pp-signal);
  }

  nav a[aria-current='page'] {
    color: var(--pp-ink-strong);
  }

  .theme {
    min-height: var(--nt-hit);
    padding: 0 var(--hf-space-3);
    background: transparent;
    border: 1px solid var(--pp-outline);
    border-radius: var(--pp-radius-md);
    cursor: pointer;
  }

  .theme:hover {
    border-color: var(--pp-signal);
  }

  .sun,
  .moon {
    width: var(--hf-space-5);
    height: var(--hf-space-5);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    vertical-align: middle;
  }

  .moon {
    display: none;
  }

  .menu {
    display: none;
    min-height: var(--nt-hit);
    min-width: var(--nt-hit);
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--pp-outline);
    border-radius: var(--pp-radius-md);
    cursor: pointer;
  }

  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: var(--hf-space-5);
    height: 2px;
    background: var(--pp-ink-strong);
    border-radius: 1px;
    transition: transform var(--pp-dur-step);
  }

  .bars {
    position: relative;
  }

  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .bars::before {
    top: -6px;
  }

  .bars::after {
    top: 6px;
  }

  [data-open] .bars {
    background: transparent;
  }

  [data-open] .bars::before {
    transform: translateY(6px) rotate(45deg);
  }

  [data-open] .bars::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* On a phone the links fold into a menu button, as in an app. The scrim is dropped there so
     the margin line and punched strip run to the very top of the page. */
  @media (max-width: 699px) {
    .pp-nav {
      position: static;
    }

    .pp-nav-inner {
      background: none;
      backdrop-filter: none;
      flex-wrap: wrap;
    }

    .cv {
      margin-left: auto;
    }

    .menu {
      display: inline-flex;
      order: 4;
    }

    .theme {
      order: 3;
    }

    nav {
      display: none;
      flex-basis: 100%;
      margin-left: 0;
      order: 5;
      border-top: 1px solid var(--pp-rule);
      padding-top: var(--hf-space-3);
    }

    [data-open] nav {
      display: block;
    }

    ul {
      flex-direction: column;
      gap: 0;
    }

    nav a {
      display: block;
      padding: var(--hf-space-3) 0;
      font-size: var(--pp-fs-body);
    }
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: inline-block;
    }
  }

  :global(:root[data-theme='dark']) .sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .moon {
    display: inline-block;
  }
</style>
