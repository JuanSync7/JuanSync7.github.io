---
import { HEADER_LINKS } from '../../data/home';
import { IDENTITY } from '../../data/site';
import Monogram from '../ui/Monogram.astro';
import PixelButton from '../ui/PixelButton.astro';
import SiteSearch from './SiteSearch.astro';

interface Props {
  /** The page this is, by its lower-case nav label ('library', 'lab', ...). */
  current?: string;
}

const { current } = Astro.props;
---

<header id="site-top" class="pp-nav">
  <div class="pp-wrap pp-nav-inner">
    <a class="brand" href="/" aria-label="Juan Kok, home">
      <span class="brand-mark"><Monogram intro="none" /></span>
      <span class="brand-text">
        <span class="brand-name">Juan Kok</span>
        <span class="brand-role">// AI engineer</span>
      </span>
    </a>

    <nav id="pp-menu" class="links" aria-label="Primary">
      <ul>
        {HEADER_LINKS.map((l) => (
          <li>
            <a href={l.href} aria-current={l.label.toLowerCase() === current ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
      <PixelButton class="cv cv-menu" href={IDENTITY.cvFile}>Download CV ↓</PixelButton>
    </nav>

    <div class="tools">
      <SiteSearch />
      <button class="icon theme" type="button" data-theme-toggle aria-label="Switch between light and dark theme">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" /></svg><svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" /></svg>
      </button>
      <PixelButton class="cv cv-bar" href={IDENTITY.cvFile}>CV ↓</PixelButton>
      <button class="icon menu" type="button" aria-expanded="false" aria-controls="pp-menu" aria-label="Menu">
        <span class="bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    function apply() {
      var b = document.querySelector('[data-theme-toggle]');
      if (!b || b.dataset.bound) return;
      b.dataset.bound = '1';
      b.addEventListener('click', function () {
        var root = document.documentElement;
        var dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        var next = dark ? 'light' : 'dark';
        function change() {
          root.dataset.theme = next;
          try { localStorage.setItem('pp-theme', next); } catch (e) {}
        }
        if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) {
          change();
          return;
        }
        root.classList.add('pp-theming');
        var t = document.startViewTransition(change);
        t.finished.finally(function () { root.classList.remove('pp-theming'); });
      });
    }
    function menu() {
      var m = document.querySelector('.pp-nav .menu');
      if (!m || m.dataset.bound) return;
      m.dataset.bound = '1';
      var nav = m.closest('.pp-nav');
      function set(open) {
        nav.toggleAttribute('data-open', open);
        m.setAttribute('aria-expanded', String(open));
      }
      m.addEventListener('click', function () { set(!nav.hasAttribute('data-open')); });
      nav.addEventListener('click', function (e) { if (e.target.closest('.links a')) set(false); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
    }
    // The bar draws its hairline once the page has scrolled under it.
    function stuck() {
      var nav = document.querySelector('.pp-nav');
      if (!nav || nav.dataset.watch) return;
      nav.dataset.watch = '1';
      function on() { nav.toggleAttribute('data-stuck', window.scrollY > 4); }
      on();
      window.addEventListener('scroll', on, { passive: true });
    }
    apply();
    menu();
    stuck();
    document.addEventListener('astro:page-load', function () { apply(); menu(); stuck(); });
    document.addEventListener('astro:after-swap', function () {
      try {
        var t = localStorage.getItem('pp-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    });
  })();
</script>

<style>
  /* The scrim runs the full width of the page (17 Nov 2026), so content scrolling under the bar
     is covered edge to edge, the punched strip and margin line included. */
  .pp-nav {
    position: sticky;
    top: 0;
    z-index: var(--hf-z-nav);
    background: var(--nt-scrim);
    backdrop-filter: blur(var(--pp-nav-blur));
    border-bottom: 1px solid transparent;
    transition: border-color var(--pa-motion-duration) ease;
  }

  .pp-nav[data-stuck] {
    border-bottom-color: var(--pp-rule);
  }

  /* One bar, three zones: who (left), where (centre), tools (right). */
  .pp-nav-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--hf-space-6);
    min-height: var(--pp-nav-h);
  }

  /* Who: the monogram, the name, and the role in the code-comment voice. */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--hf-space-3);
    justify-self: start;
    color: var(--pp-ink-strong);
  }

  .brand-mark {
    display: block;
    height: var(--pp-nav-mark-h);
  }

  .brand-text {
    display: grid;
    line-height: var(--pp-lh-h2);
  }

  .brand-name {
    font-size: var(--pp-fs-title);
    font-weight: var(--pp-w-title);
    letter-spacing: var(--pp-tracking-mark);
    color: var(--pp-ink-strong);
  }

  .brand-role {
    font-family: var(--pp-mono);
    font-size: var(--pp-fs-micro);
    font-weight: var(--pp-w-label);
    color: var(--pp-ink-muted);
  }

  .brand:hover .brand-name {
    color: var(--pp-ink-strong);
  }

  /* Where: the pages. The current one carries an orange tab that sits on the bar's hairline. */
  .links {
    align-self: stretch;
    display: flex;
  }

  ul {
    display: flex;
    align-items: stretch;
    gap: var(--hf-space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links li {
    display: flex;
  }

  .links ul a {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0 var(--hf-space-3);
    font-size: var(--pp-fs-nav);
    font-weight: var(--pp-w-nav);
    color: var(--pp-ink-muted);
    transition: color var(--pa-motion-duration) ease;
  }

  .links ul a::after {
    content: '';
    position: absolute;
    left: var(--hf-space-3);
    right: var(--hf-space-3);
    bottom: -1px;
    height: var(--pp-nav-tab);
    background: var(--pp-signal);
    transform: scaleX(0);
    transition: transform var(--pa-motion-duration) var(--pp-ease-rise);
  }

  .links ul a:hover {
    color: var(--pp-ink-strong);
  }

  .links ul a:hover::after {
    transform: scaleX(0.5);
  }

  .links ul a[aria-current='page'] {
    color: var(--pp-ink-strong);
  }

  .links ul a[aria-current='page']::after {
    transform: scaleX(1);
  }

  /* The CV is the hero's pixel button at bar height. It is another component's element, so
     these rules are global and name the bar to outrank the button's own. */
  :global(.pp-nav .cv) {
    min-height: var(--pp-nav-icon);
    padding: var(--hf-space-2) var(--hf-space-4);
    font-size: var(--pp-fs-caption);
  }

  :global(.pp-nav .links .cv-menu) {
    display: none;
  }

  /* Tools: search, theme and CV, one height. */
  .tools {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--hf-space-3);
  }

  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--pp-nav-icon);
    height: var(--pp-nav-icon);
    padding: 0;
    color: var(--pp-ink-muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--pp-radius-md);
    cursor: pointer;
    transition:
      color var(--pa-motion-duration) ease,
      border-color var(--pa-motion-duration) ease;
  }

  .icon:hover {
    color: var(--pp-ink-strong);
    border-color: var(--pp-outline);
  }

  .sun,
  .moon {
    width: var(--hf-space-5);
    height: var(--hf-space-5);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .moon {
    display: none;
  }

  .menu {
    display: none;
    border-color: var(--pp-outline);
  }

  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: var(--hf-space-4);
    height: var(--pp-bar-h);
    background: var(--pp-ink-strong);
    border-radius: 1px;
    transition: transform var(--pp-dur-step);
  }

  .bars {
    position: relative;
  }

  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .bars::before {
    top: calc(-1 * var(--pp-bar-gap));
  }

  .bars::after {
    top: var(--pp-bar-gap);
  }

  [data-open] .bars {
    background: transparent;
  }

  [data-open] .bars::before {
    transform: translateY(var(--pp-bar-gap)) rotate(45deg);
  }

  [data-open] .bars::after {
    transform: translateY(calc(-1 * var(--pp-bar-gap))) rotate(-45deg);
  }

  /* Mid widths: the role line goes before the links get crowded. */
  @media (max-width: 1099px) {
    .brand-role {
      display: none;
    }

    .links ul a {
      padding: 0 var(--hf-space-2);
    }

    .links ul a::after {
      left: var(--hf-space-2);
      right: var(--hf-space-2);
    }
  }

  /* On a phone the pages fold into a menu, as in an app: a list under the bar with the CV at
     its foot. The scrim is dropped so the margin line and punched strip run to the top. */
  @media (max-width: 799px) {
    .pp-nav {
      position: static;
      background: none;
      backdrop-filter: none;
    }

    .pp-nav-inner {
      grid-template-columns: 1fr auto;
      grid-template-rows: var(--pp-nav-h) auto;
      row-gap: 0;
    }

    .menu {
      display: inline-flex;
    }

    :global(.pp-nav .tools .cv-bar) {
      display: none;
    }

    .tools {
      grid-row: 1;
      grid-column: 2;
    }

    .links {
      display: none;
      grid-row: 2;
      grid-column: 1 / -1;
      flex-direction: column;
      gap: var(--hf-space-4);
      padding: var(--hf-space-2) 0 var(--hf-space-6);
      border-top: 1px solid var(--pp-rule);
    }

    [data-open] .links {
      display: flex;
    }

    ul {
      flex-direction: column;
      gap: 0;
    }

    .links ul a {
      flex: 1;
      padding: var(--hf-space-3) 0;
      font-size: var(--pp-fs-lead);
      border-bottom: 1px solid var(--pp-rule);
    }

    .links ul a::after {
      left: 0;
      right: auto;
      top: 0;
      bottom: 0;
      width: var(--pp-nav-tab);
      height: auto;
      transform: scaleY(0);
    }

    .links ul a[aria-current='page'] {
      padding-left: var(--hf-space-4);
    }

    .links ul a[aria-current='page']::after {
      transform: scaleY(1);
    }

    :global(.pp-nav .links .cv-menu) {
      display: inline-block;
      align-self: start;
      min-height: var(--nt-hit);
      padding: var(--hf-space-3) var(--hf-space-6);
      font-size: var(--pp-fs-label);
    }

    .links ul a:hover::after {
      transform: scaleY(0);
    }
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: block;
    }
  }

  :global(:root[data-theme='dark']) .sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .moon {
    display: block;
  }
</style>
