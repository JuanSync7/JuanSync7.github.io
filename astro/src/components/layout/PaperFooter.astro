---
import { FOOTER, NAV } from '../../data/home';
import { IDENTITY } from '../../data/site';
---

<footer class="pp-foot">
  <div class="pp-wrap inner">
    <nav aria-label="Site">
      <a href="/">home</a>
      {NAV.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href="/design-system">design system</a>
      <a href={IDENTITY.cvFile}>cv.pdf</a>
    </nav>
    <p class="hand">{FOOTER.joke}</p>
    <p class="pp-caption">{FOOTER.part}</p>
  </div>
</footer>

<style>
  .pp-foot {
    border-top: 1px solid var(--pp-rule);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-4);
    padding-top: var(--hf-space-8);
    padding-bottom: var(--hf-space-12);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hf-space-2) var(--hf-space-6);
    font-family: var(--pp-mono);
    font-size: var(--pp-fs-caption);
    font-weight: var(--pp-w-label);
  }

  nav a {
    color: var(--pp-ink-muted);
  }

  .hand {
    font-family: var(--pp-hand);
    font-size: var(--pp-fs-hand-line);
    line-height: var(--pp-lh-hand-line);
    font-weight: var(--pp-w-hand-line);
    color: var(--pp-ink-strong);
    text-shadow: 0 0 1px color-mix(in srgb, var(--pp-ink-strong) 35%, transparent);
    transform: rotate(-1deg);
    transform-origin: left center;
  }
</style>
