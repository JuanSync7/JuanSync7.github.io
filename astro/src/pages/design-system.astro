---
import NightPage from '../layouts/NightPage.astro';
import NightNav from '../components/layout/NightNav.astro';
import NightFooter from '../components/layout/NightFooter.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import PaperAction from '../components/ui/PaperAction.astro';
import PixelButton from '../components/ui/PixelButton.astro';
import MarginNote from '../components/ui/MarginNote.astro';
import Monogram from '../components/ui/Monogram.astro';
import FigureCanvas from '../components/ui/FigureCanvas';
import FigurePlate from '../components/ui/FigurePlate';
import HardwareIcon from '../components/ui/HardwareIcon';
import Sticker from '../components/ui/Sticker.astro';
import { deskTones } from '../styles/tokens/palette';
import SlideIcon from '../components/ui/SlideIcon';
import PostGrid from '../components/writing/PostGrid';
import type { PostSummary } from '../components/writing/types';
import { CATEGORY_LABEL } from '../data/writing';
import { libraryCards } from '../data/library-cards';
import CodeExample from '../components/design-system/CodeExample.astro';
import BlueprintView from '../components/design-system/BlueprintView.astro';
import SourceFiles from '../components/design-system/SourceFiles.astro';
import LegacyGallery from '../components/design-system/LegacyGallery.astro';
import ContrastTable from '../components/design-system/ContrastTable.astro';
import TokenExport from '../components/design-system/TokenExport.astro';
import { tokens, tokenFiles as foundationTokenFiles, colorGroups, source, pageRecipe, readingRecipe, figureRecipe, trackerRecipe } from '../components/design-system/reference';
import '../styles/design-system.css';
import '../styles/night-prose.css';
import '../styles/learn-paper.css';

const tokenFiles = [...foundationTokenFiles, 'presentation', 'buttons', 'blueprint'];
const colors = tokens('colors');
const roomTokenNames = [
  '--nt-room-ivory',
  '--nt-room-plaster',
  '--nt-room-sage',
  '--nt-room-forest',
  '--nt-room-oak',
  '--nt-room-walnut',
  '--nt-room-graphite',
  '--nt-room-steel',
  '--nt-room-brass',
  '--nt-room-navy',
  '--nt-room-blue',
  '--nt-room-teal',
  '--nt-room-clay',
  '--nt-room-burgundy',
  '--nt-room-lavender',
  '--nt-room-linen',
  '--nt-room-glass',
  '--nt-room-rust',
  '--nt-room-amber',
  '--nt-room-daylight',
  '--nt-room-porcelain',
  '--nt-room-ink',
];
const paletteGroups = [
  { title: 'Themed rooms · materials & light', test: (name: string) => roomTokenNames.includes(name) },
  ...colorGroups,
];
const sizes = tokens('typography').filter((t) => t.name.startsWith('--nt-fs'));
const sections = [ ['overview', 'Overview'], ['foundations', 'Foundations'], ['standards', 'Standards'], ['type', 'Typography'], ['layout', 'Layout & motion'], ['patterns', 'Page patterns'], ['paper', 'Paper system'], ['components', 'Components'], ['legacy', 'Legacy library'] ];
const paperRaw = tokens('paper');
const paperColours = ['ground', 'ink-strong', 'ink', 'ink-muted', 'rule', 'outline', 'arrow', 'signal', 'signal-shadow', 'on-signal', 'signal-2', 'signal-2-text', 'sheet', 'strip'].map((n) => {
  const value = paperRaw.find((t) => t.name === `--pp-${n}`)?.value ?? '';
  const pair = value.match(/^light-dark\(\s*([^,]+?)\s*,\s*([^)]+?)\s*\)$/);
  return { name: `--pp-${n}`, light: pair?.[1] ?? value, dark: pair?.[2] ?? value };
});
const paperType = paperRaw.filter((t) => /^--pp-(fs|w|lh|tracking)-/.test(t.name));
const paperSpace = paperRaw.filter((t) => /^--pp-(radius|shadow-step|dur|measure|pad)/.test(t.name));
const libraryTokens = paperRaw.filter((t) => t.name.startsWith('--pp-lib-'));
const pages = [
  { name: 'Home', href: '/', path: 'pages/index.astro', kind: 'System overview', note: 'Night chrome, large display type, live city and a DOM system map.' },
  { name: 'Blog', href: '/blog/', path: 'pages/blog/index.astro', kind: 'Browse & discover', note: 'Featured pages, the lesson log and filterable post cards; links to the library.' },
  { name: 'Library', href: '/library/', path: 'pages/library/index.astro', kind: 'Find anything', note: 'Every post and field guide as binders on a shelf for each kind; a picked binder opens on the desk.' },
  { name: 'Articles', href: '/library/articles/', path: 'pages/library/articles.astro', kind: 'Read & understand', note: 'Night index; article bodies follow the reader’s light or dark preference.' },
  { name: 'Trackers', href: '/trackers/', path: 'layouts/TrackerLayout.astro', kind: 'Compare releases', note: 'Shared tracker navigation, a left version rail and centered release detail.' },
  { name: 'Lab', href: '/lab/', path: 'pages/lab/index.astro', kind: 'Explore & reuse', note: 'Seeded figure templates and an exportable hardware icon kit.' },
  { name: 'Anatomy', href: '/anatomy/chip-package/', path: 'pages/anatomy/chip-package.astro', kind: 'Inspect a system', note: 'Step controls and selectable parts beside an explanatory figure.' },
];
const landingRecipe = `---
import PresentationLayout from '../layouts/PresentationLayout.astro';
import PaperAction from '../components/ui/PaperAction.astro';
---
<PresentationLayout kind="landing" title="A useful promise · Juan Kok" description="What this system helps someone do.">
  <header class="nt-wrap">
    <p class="pr-comment">// a short introduction</p>
    <h1 class="pr-title">A clear outcome.</h1>
    <p class="pr-body">One paragraph explaining why it is useful.</p>
    <PaperAction href="/vault/architecture/">Explore the architecture</PaperAction>
  </header>
  <!-- Keep the overview concise. Put implementation and evidence in linked guides. -->
</PresentationLayout>`;
const posts: PostSummary[] = (await libraryCards()).slice(0, 2);
const postRecipe = `---\nimport PostGrid from '../components/writing/PostGrid';\nimport { CATEGORY_LABEL } from '../data/writing';\nconst posts = ${JSON.stringify(posts, null, 2)};\n---\n<PostGrid posts={posts} labels={CATEGORY_LABEL} client:visible />`;
---

<NightPage title="Design system · Juan Kok" description="The visual language of juansync.dev: live foundations, page patterns and shared components, with copyable usage and source code.">
  <a class="ds-skip" href="#overview">Skip to design system</a>
  <NightNav />
  <main data-design-system class="ds-page">
    <header class="nt-wrap ds-hero">
      <div class="ds-hero-copy">
        <span class="nt-label">// design_system · living reference</span>
        <h1>The parts.<br /><span>The whole system.</span></h1>
        <p>The visual language of juansync.dev, from a single orange signal to the pages built around it. Explore the patterns, try the components, take the code.</p>
        <div class="ds-actions"><PixelButton href="#components">Explore components</PixelButton><a class="ds-text-link" href="#patterns">Build a page</a></div>
      </div>
      <div class="ds-specimen" aria-label="Site identity specimen">
        <div class="ds-specimen-top"><span>juan_kok</span><span>night / 2026</span></div>
        <div class="ds-mark"><Monogram intro="none" /></div>
        <div class="ds-specimen-bottom"><span>Near-black. Cool ink.<br />One orange signal.</span><span class="ds-signal-mark" aria-hidden="true">↗</span></div>
      </div>
    </header>

    <div class="nt-wrap ds-shell">
      <aside class="ds-index"><nav aria-label="On this page"><span class="ds-eyebrow">On this page</span>{sections.map(([id, label], i) => <a href={`#${id}`} data-section-link><span>{String(i + 1).padStart(2, '0')}</span>{label}</a>)}</nav><p>Usage first.<br />Source when you need it.</p></aside>
      <div class="ds-content">
        <section id="overview" data-ds-section class="ds-section">
          <SectionHead label="// 01 · overview" title="One site. Several kinds of page." lead="A shared night shell connects the site. The content determines how much space, detail and motion belongs inside it." />
          <div class="ds-page-grid">{pages.map((page) => <article class="ds-page-card"><span class="ds-eyebrow">{page.kind}</span><h3><a href={page.href}>{page.name}</a></h3><p>{page.note}</p><a class="ds-source-link" href={`https://github.com/JuanSync7/JuanSync7.github.io/blob/main/astro/src/${page.path}`}>View page source ↗</a></article>)}</div>
          <div class="ds-callout"><span class="nt-label">Start here</span><p>Use <code>--nt-*</code> for current pages, <code>NightPage</code> for the shell, and shared components for repeated patterns. The lime, typewriter and lofi library remains available below for older sections.</p></div>
        </section>

        <section id="foundations" data-ds-section class="ds-section">
          <SectionHead label="// 02 · foundations" title="Colour has a job." lead="Grounds recede, ink stays readable, orange marks an action or a point of attention. Hairlines separate content without turning every section into a filled card." />
          <p class="ds-note">Each swatch copies its CSS variable. Values and token lists come directly from the production token files at build time.</p>
          {paletteGroups.map((group) => <div class="ds-token-group"><h3>{group.title}</h3><div class="ds-swatches">{colors.filter((t) => group.test(t.name)).map((t) => <button type="button" class="ds-swatch" data-copy-token={`var(${t.name})`} aria-label={`Copy var(${t.name})`}><span class="ds-chip" style={`background: var(${t.name})`} aria-hidden="true"></span><span class="ds-token-name">{t.name}</span><span class="ds-token-value">{t.value}</span><span class="ds-copy-hint">Copy variable</span></button>)}</div></div>)}
          <CodeExample title="colors.css · all definitions" code={source('styles/tokens/colors.css')} />
        </section>

        <section id="standards" data-ds-section class="ds-section">
          <SectionHead label="// 02b · standards" title="Named by a standard. Checked by one." lead="The tokens are published in the W3C Design Tokens format, so a design tool can read them. Every colour pair is measured with the WCAG 2.2 formula, which is also the international standard ISO/IEC 40500:2025." />
          <article class="ds-component" id="contrast"><div class="ds-component-head"><h3>Contrast · WCAG 2.2</h3><span class="ds-badge">ISO/IEC 40500:2025</span></div><p>Body text needs 4.5:1 against its ground (1.4.3), 7:1 for AAA (1.4.6). Large text, and graphics or control edges someone needs to see, need 3:1 (1.4.3, 1.4.11). Each row is measured in both themes from the tokens; the sample shows the theme you are in.</p><ContrastTable /><p class="ds-note"><code>npm run standards:check</code> fails if any pair drops below what it needs, on either page. The pairs live in <code>src/data/contrast-pairs.ts</code>.</p></article>
          <article class="ds-component" id="design-tokens"><div class="ds-component-head"><h3>Tokens · W3C DTCG 2025.10</h3><span class="ds-badge">.tokens.json</span></div><p>The CSS token files stay the source. At build they are read into the Design Tokens Format Module 2025.10: a foundation file, a light and a dark theme file, and a resolver that joins them. Each token keeps its CSS name in <code>$extensions</code>, so a value read in a design tool leads straight back to the code.</p><TokenExport /></article>
        </section>

        <section id="type" data-ds-section class="ds-section">
          <SectionHead label="// 03 · typography" title="Three voices. One hierarchy." lead="Space Grotesk sets the direction. Geist does the reading. JetBrains Mono carries labels, navigation and code." />
          <div class="ds-fonts">{[['Space Grotesk', '--nt-display', 'Display / 500–600', 'A system worth understanding.'], ['Geist', '--nt-sans', 'Reading / 400–600', 'Clear words, room to think.'], ['JetBrains Mono', '--nt-mono', 'Labels & code / 400–700', '// evidence → understanding'], ['ISO Lettering B', '--nt-drafting', 'Engineering drawings / ISO 3098', 'SECTION A-A (1:5) Ø 12 ± 0.5']].map(([name, token, role, text]) => <article class="ds-font"><span class="ds-eyebrow">{role}</span><h3>{name}</h3><p style={`font-family: var(${token})`}>{text}</p><button class="ds-token-button" type="button" data-copy-token={`var(${token})`}>{token}</button></article>)}</div>
          <article id="presentation-hierarchy" class="ds-hierarchy" aria-label="Presentation text hierarchy">
            <span class="ds-eyebrow">Title / body / comment · three explicit roles</span>
            <h3 class="ds-pr-title" data-text-role="title">The work keeps its meaning.</h3>
            <p class="ds-pr-body" data-text-role="body">Readable prose carries the explanation. Headings stay brighter and stronger; comments stay quieter without disappearing.</p>
            <p class="ds-pr-comment" data-text-role="comment">// November 2026 · a concise public overview</p>
            <div class="ds-token-list">{tokens('presentation').filter((t) => ['--pr-title', '--pr-body', '--pr-comment', '--pr-label'].includes(t.name)).map((t) => <button type="button" data-copy-token={`var(${t.name})`}><code>{t.name}</code><span>{t.value}</span></button>)}</div>
          </article>
          <p class="ds-note">New presentation pages use distinct title, body and comment roles. Background contrast and separation between roles are checked by the presentation contract. A quiet comment still has readable contrast; a gradient does not carry essential text.</p>
          <details class="ds-disclosure"><summary>Type scale · {sizes.length} sizes</summary><div class="ds-type-scale">{sizes.map((t) => <div><button type="button" class="ds-token-button" data-copy-token={`var(${t.name})`}>{t.name}</button><span class="ds-token-value">{t.value}</span><p style={`font-size: var(${t.name}); font-family: var(--nt-display); line-height: var(--nt-lh-heading)`}>Form follows understanding.</p></div>)}</div></details>
          <p class="ds-note">Base text: 16px at 1.6 line height; article prose: 17px. Introductory text uses a 640px measure; article bodies follow the page container. Headings use tighter line height and tracking. The full file also retains the older Special Elite and Caveat stacks.</p>
          <CodeExample title="typography.css · stacks, scale & rhythm" code={source('styles/tokens/typography.css')} />
        </section>

        <section id="layout" data-ds-section class="ds-section">
          <SectionHead label="// 04 · layout & motion" title="Space to read. Motion with purpose." lead="A 4px spacing scale, fluid gutters and generous section rhythm. Movement explains continuity; reduced motion removes it." />
          <div class="ds-layout-demo" aria-label="Layout specimen"><div class="ds-layout-label">.nt-wrap · max 1200px</div><div class="ds-layout-inner"><span>--nt-gutter<br />16–48px</span><div><span class="nt-label">.nt-section</span><h3>Let the content breathe.</h3><p>72–120px between sections. Use --nt-measure for text that should stay comfortably readable.</p></div></div></div>
          <div class="ds-spacing">{tokens('spacing').filter((t) => t.name.startsWith('--hf-space')).sort((a,b) => parseInt(a.value) - parseInt(b.value)).map((t) => <button type="button" data-copy-token={`var(${t.name})`}><span style={`height: var(${t.name})`} aria-hidden="true"></span><strong>{t.value}</strong><small>{t.name}</small></button>)}</div>
          <div class="ds-radii">{tokens('spacing').filter((t) => t.name.startsWith('--hf-radius')).map((t) => <button type="button" data-copy-token={`var(${t.name})`} style={`border-radius: var(${t.name})`}>{t.name.replace('--hf-radius-', '')}<small>{t.value}</small></button>)}</div>
          <div class="ds-callout"><span class="nt-label">Movement</span><p>Every public page uses Astro’s router and renders <code>PageTurn</code>, so every page swap turns the whole page like a notepad sheet, nav and covers included. The turn takes <code>--pp-dur-flip</code> (1100ms) and moves only transform and opacity, so the compositor plays it however busy the page is. Under reduced motion, pages swap without it. No scroll hijacking.</p></div>
          {tokenFiles.filter((file) => !['colors', 'typography'].includes(file)).map((file) => <CodeExample title={`${file}.css · all definitions`} code={source(`styles/tokens/${file}.css`)} />)}
          <details class="ds-disclosure"><summary>Complete layout, effect & motion token index</summary><div class="ds-token-list">{['spacing', 'gradients', 'motion', 'presentation', 'buttons'].flatMap((file) => tokens(file)).map((t) => <button type="button" data-copy-token={`var(${t.name})`}><code>{t.name}</code><span>{t.value}</span></button>)}</div></details>
        </section>

        <section id="patterns" data-ds-section class="ds-section">
          <SectionHead label="// 05 · page patterns" title="Start with the right structure." lead="These are the layouts used by the site today. Copy a starting point, then keep the real components and their dependencies together." />
          <article class="ds-pattern"><div class="ds-pattern-title"><span class="ds-number">01</span><div><h3>The night page</h3><p>Home, writing, learn, lab and anatomy share NightPage, NightNav and NightFooter—the same chrome used here.</p></div></div><CodeExample title="Night page · starter.astro" code={pageRecipe} open /><SourceFiles paths={['layouts/NightPage.astro','layouts/NightLayout.astro','components/layout/NightNav.astro','components/layout/NightFooter.astro','styles/night.css']} /><p class="ds-note"><a href="/lab/blueprints/paper-nav/">Nav blueprint</a> · <a href="/lab/blueprints/paper-footer/">Footer blueprint</a> · <a href="/lab/blueprints/home/">Home page blueprint</a></p></article>
          <article class="ds-pattern"><div class="ds-pattern-title"><span class="ds-number">02</span><div><h3>The reading page</h3><p>Night chrome around a restrained article. Learn bodies become cream paper for light-mode readers; dark-mode readers keep the night ground. Code sits in a terminal window that follows the theme, white on light and dark on dark.</p></div></div><div class="ds-reading-pair"><div class="ds-reading-sample"><span class="ds-eyebrow">Night / dark preference</span><h3>Evidence before confidence.</h3><p>Readable prose, quiet lines and a single highlight.</p></div><div class="ds-reading-sample ds-paper-sample"><span class="ds-eyebrow">Paper / light preference</span><h3>Evidence before confidence.</h3><p>The same hierarchy, on warm paper with darker ink.</p></div></div><CodeExample title="Reading body · usage" code={readingRecipe} /><SourceFiles paths={['styles/night-prose.css','styles/learn-paper.css']} /><p class="ds-note"><a href="/lab/blueprints/blog-post/">Blog post blueprint</a> · <a href="/lab/blueprints/learn-article/">Learn article blueprint</a> · <a href="/lab/blueprints/writing-index/">Writing index blueprint</a> · <a href="/lab/blueprints/learn-index/">Learn index blueprint</a></p></article>
          <article class="ds-pattern"><div class="ds-pattern-title"><span class="ds-number">03</span><div><h3>The tracker</h3><p>A shared navigation row above a flush-left version-history rail and centered release details. Engines, frontier models and silicon use the same shell; each supplies its own content grid.</p></div></div><CodeExample title="Tracker · starter.astro" code={trackerRecipe} /><SourceFiles paths={['layouts/TrackerLayout.astro','components/trackers/_chrome.css','components/trackers/tracker-night.css']} /><a class="ds-text-link" href="/trackers/">See the trackers</a><p class="ds-note"><a href="/lab/blueprints/tracker/">Tracker blueprint</a></p></article>
          <article class="ds-pattern"><div class="ds-pattern-title"><span class="ds-number">04</span><div><h3>The interactive explorer</h3><p>Lab pairs figure templates with seeds and a hardware icon kit with export controls. Anatomy pairs a figure with step navigation and readable part descriptions. Keep labels and controls in the DOM; mount the drawing with FigureCanvas.</p></div></div><div class="ds-actions"><a class="ds-text-link" href="/lab/">Explore the lab</a><a class="ds-text-link" href="/lab/icon-kit/">Hardware atlas</a><a class="ds-text-link" href="/anatomy/chip-package/">Inspect a chip package</a></div><SourceFiles paths={['pages/lab/index.astro','pages/lab/icon-kit.astro','pages/anatomy/chip-package.astro']} /><p class="ds-note"><a href="/lab/blueprints/lab/">Lab index blueprint</a></p></article>
          <article class="ds-pattern"><div class="ds-pattern-title"><span class="ds-number">05</span><div><h3>The presentation page</h3><p>Lead with an outcome, a clear promise and a useful next step. Keep the landing page at a high level; move architecture, definitions, examples and checks into linked guides.</p></div></div><div class="ds-stage ds-landing-preview"><p class="ds-pr-comment">// the experience vault</p><h3 class="ds-pr-title">Keep the useful part.</h3><p class="ds-pr-body">One small introduction; deeper context when a question needs it.</p><div class="ds-actions"><PaperAction href="/vault/" variant="paper">See the landing page</PaperAction><PaperAction href="/vault/architecture/" variant="signal">Read a guide</PaperAction></div></div><CodeExample title="Presentation page · starter.astro" code={landingRecipe} /><SourceFiles paths={['layouts/PresentationLayout.astro','styles/tokens/presentation.css','components/ui/PaperAction.astro','components/vault/VaultFileCabinet.tsx','components/vault/useCabinetPose.ts','components/vault/vault-file-cabinet.css','figures/vault-cabinet.ts','components/presentation/heading-reveals.ts','components/presentation/landing-scroll.ts']} /><p class="ds-note">Use the same text roles on the guides. The vault cabinet shares its camera with native folder links; a renderer-generated poster preserves them without JavaScript. ScrollTrigger coordinates drawer travel, masked heading words and guide cards. Motion marks section continuity; reduced motion and a missing script keep all copy readable.</p><p class="ds-note"><a href="/lab/blueprints/presentation/">Presentation blueprint</a></p></article>
          <article class="ds-pattern"><div class="ds-pattern-title"><span class="ds-number">06</span><div><h3>The library archive</h3><p>Two baked figures (library-wall and library-desk, shown with FigurePlate) drawn in pen and wash by the art playbooks' kernel in the --pp-art-* palette. One shelf per kind of writing turns like a carousel from the names above it; every binder is a link. A picked binder flies to the desk in a real 3D turn, lands spine left, opens, and its paper comes out: the cover figure on the left, the words and the way in on the right. Only transforms animate, every length and time is a --pp-lib-* token, and the stage scales as one below --pp-lib-view-min.</p></div></div><a class="ds-text-link" href="/library/">Open the library</a><div class="ds-token-group"><h3>Library tokens</h3><div class="ds-token-list">{libraryTokens.map((t) => <button type="button" data-copy-token={`var(${t.name})`}><code>{t.name}</code><span>{t.value}</span></button>)}</div></div><SourceFiles paths={['components/library/archive/LibraryArchive.tsx','components/library/archive/ShelfTrack.tsx','components/library/archive/BinderFlight.tsx','components/library/archive/ArchiveSheet.tsx','components/library/archive/geometry.ts','components/library/archive/archive.css','components/library/archive/binder.css','components/library/archive/sheet.css']} /><p class="ds-note">The plates come from the art playbooks' kernel (scripts/library-art/, npm run library-art), their sizes and anchors from their manifests, and text is never baked into them. Words on the wall (the shelf plaque, the spines, the caption) are DOM.</p></article>
        </section>

        <section id="paper" data-ds-section class="ds-section">
          <SectionHead label="// 05b · paper system" title="A notepad by day. A notepad by night." lead="The home page's redesign: cream and gunmetal grounds, one signal orange, Manrope with JetBrains Mono and Caveat. Light follows the visitor's setting until they choose; both themes share one token set. Page swaps curl the old page away from its bottom-right corner, its paper back folded over and the next page showing behind the fold (--pp-dur-flip, --pp-curl-gleam, --pp-curl-blur, --pp-curl-crease, --pp-curl-sheen). Blog posts and field guides sit in a docs layout: a pane of sibling documents, the article, and On this page (--pp-doc-nav-w, --pp-doc-toc-w, --pp-doc-gap). The article holds a reading measure of 70 to 81 characters a line and centres in its column, so a wider screen adds room around it rather than longer lines (--pp-doc-measure). Its text follows a reading scale of one contrast step per level, title to body, with the side panels set back (--pp-read-title, --pp-read-h2, --pp-read-h3, --pp-read-h4, --pp-read-body, --pp-read-nav). The site chrome is a three-zone header bar (who, pages and tools, with an orange tab on the current page sitting on the bar's hairline) and a footer laid out as a drawing's title block (--pp-nav-h, --pp-nav-mark-h, --pp-nav-blur, --pp-nav-tab, --pp-nav-icon, --pp-foot-mark-h, --pp-foot-brand-w). The bar's search opens a notepad sheet under it (--pp-search-field-w, --pp-search-w, --pp-search-top, --pp-search-list-h), and the site index draws every page as a tree of addresses (--pp-index-indent, --pp-index-w)." />
          <p class="ds-note">Two oranges on purpose: --pp-signal is the deeper #f04a0e on Light and the brighter #ff5a1f on Dark, so it reads as the same colour on both grounds. It is for fills, rules and large type; small text stays in ink. --pp-signal-2 is the second accent, the orange's opposite turned a little towards violet: a sliver of the 10%, with --pp-signal-2-text for small text. Body weight is 450, not 500.</p>
          <div class="ds-token-group"><h3>Colour · light and dark</h3><div class="ds-swatches">{paperColours.map((t) => <button type="button" class="ds-swatch" data-copy-token={`var(${t.name})`} aria-label={`Copy var(${t.name})`}><span class="ds-chip" style={`background: ${t.light}`} aria-hidden="true"></span><span class="ds-token-name">{t.name}</span><span class="ds-token-value">{t.light} · {t.dark}</span><span class="ds-copy-hint">Copy variable</span></button>)}</div></div>
          <div class="ds-token-group"><h3>Type · scale, weights, line heights</h3><div class="ds-token-list">{paperType.map((t) => <button type="button" data-copy-token={`var(${t.name})`}><code>{t.name}</code><span>{t.value}</span></button>)}</div></div>
          <div class="ds-token-group"><h3>Radius, step and frame</h3><div class="ds-token-list">{paperSpace.map((t) => <button type="button" data-copy-token={`var(${t.name})`}><code>{t.name}</code><span>{t.value}</span></button>)}</div></div>
          <CodeExample title="paper.css · all definitions" code={source('styles/tokens/paper.css')} />
        </section>

        <section id="components" data-ds-section class="ds-section">
          <SectionHead label="// 06 · shared components" title="Real components. Real examples." lead="These previews render the production components. Usage snippets assume the Astro + React project and imports relative to src/pages/. Source is included for inspection and reuse." /><p class="ds-note">Each component with a blueprint shows it under its example: every part numbered, every size named by its token. Page templates have theirs in the lab: <a href="/lab/blueprints/">all blueprints</a></p>
          <article class="ds-component"><div class="ds-component-head"><h3>SectionHead</h3><span class="ds-badge">Astro · static</span></div><p>The mono label, two-tone heading and lead used across night pages. Use as="h1" once for the page title.</p><div class="ds-stage"><SectionHead label="// a shared pattern" title="Make it understandable." accent="Then make it work." lead="A familiar opening, wherever you are on the site." /></div><CodeExample title="SectionHead · usage" code={`---
import SectionHead from '../components/ui/SectionHead.astro';\n---\n<SectionHead label="// a shared pattern" title="Make it understandable." accent="Then make it work." lead="A familiar opening." />`} /><SourceFiles paths={['components/ui/SectionHead.astro']} /><span class="ds-eyebrow">Blueprint</span><BlueprintView id="section-head"><SectionHead label="// a shared pattern" title="Make it understandable." accent="Then make it work." lead="A familiar opening, wherever you are on the site." /></BlueprintView><CodeExample title="section-head.ts · blueprint spec" code={source('blueprints/section-head.ts')} /><a class="ds-text-link" href="/lab/blueprints/section-head/">Its page in the blueprint lab</a></article>
          <article id="pixel-button" class="ds-component"><div class="ds-component-head"><h3>PixelButton</h3><span class="ds-badge">Astro · link</span></div><p>The 8-bit button of the paper system: a signal or outlined face with a hard shadow that grows on hover and sinks on press, moving in steps. The label sits on --pp-on-signal or --pp-ink-strong, never on bare orange text.</p><div class="ds-stage"><div class="ds-actions"><PixelButton href="#paper">See the system</PixelButton><PixelButton href="#paper" variant="outline">Get in touch</PixelButton></div></div><CodeExample title="PixelButton · signal and outline" code={`---
import PixelButton from '../components/ui/PixelButton.astro';
---
<PixelButton href="#system">See the system</PixelButton>
<PixelButton href="#contact" variant="outline">Get in touch</PixelButton>`} /><SourceFiles paths={['components/ui/PixelButton.astro','components/ui/pixel-button.css','styles/tokens/paper.css']} /><span class="ds-eyebrow">Blueprint</span><BlueprintView id="pixel-button"><PixelButton href="#paper" variant="outline">Get in touch</PixelButton></BlueprintView><CodeExample title="pixel-button.ts · blueprint spec" code={source('blueprints/pixel-button.ts')} /><a class="ds-text-link" href="/lab/blueprints/pixel-button/">Its page in the blueprint lab</a><p class="ds-note">Minimum height follows --nt-hit. Use it for destinations on paper-system pages. It does not replace PaperAction on night pages.</p></article>
          <article id="figures-on-paper" class="ds-component"><div class="ds-component-head"><h3>Figures on paper</h3><span class="ds-badge">CSS tokens</span></div><p>Figures are drawn once, in the night palette. By day --pp-figure-filter inverts them to ink on cream and turns the teal signal to the signal orange, by night it does the same to the teal. Both are SVG filters in PaperLayout that also map the figure ground onto the page colour (cream F3ECDF, gunmetal 16191E), so the faces a figure fills with its ground match the page. A full-colour scene (rooms, voxel worlds) keeps its own colours on a --pp-figure-ground stage.</p><div class="ds-stage" style="aspect-ratio: 2"><FigureCanvas client:visible id="wafer-stack" /></div></article>
          <article id="margin-note" class="ds-component"><div class="ds-component-head"><h3>MarginNote</h3><span class="ds-badge">Astro · paper</span></div><p>A short handwritten note in the empty left margin beside the notepad strip: Caveat at the hand-line size, tilted, right-aligned. It exists only where the page leaves a gutter (container 2000px and wider) and is decorative, so it is hidden from assistive tech. Shown here without the gutter.</p><div class="ds-stage ds-margin-stage"><MarginNote text="five rules I keep coming back to" /></div><CodeExample title="MarginNote · through PaperHead" code={`<PaperHead note="five rules I keep coming back to" label="…" title="…" />`} /><SourceFiles paths={['components/ui/MarginNote.astro','styles/tokens/paper.css']} /><p class="ds-note">The parent must be position: relative. Tokens: --pp-note-w, --pp-note-gap, --pp-fs-hand-line, --pp-w-hand-line.</p></article>
          <article id="paper-actions" class="ds-component"><div class="ds-component-head"><h3>PaperAction</h3><span class="ds-badge">Astro · semantic link or button</span></div><p>A printed paper face that follows the theme (ivory by day, lifted gunmetal by night), a shallow diagonal edge and a restrained press. Essential labels have solid ink; depth is decorative.</p><div class="ds-stage"><div class="ds-actions"><PaperAction href="/vault/architecture/" variant="paper">Explore the system</PaperAction><PaperAction href="/vault/search/" variant="signal">Try the example</PaperAction><PaperAction href="/vault/guardrails/" variant="outline">Read the checks</PaperAction><PaperAction popovertarget="paper-action-note" variant="paper">Open a note<span slot="icon">+</span></PaperAction><PaperAction disabled variant="outline">Unavailable</PaperAction></div></div><div id="paper-action-note" popover class="ds-paper-note"><p class="ds-pr-comment">// a native button action</p><h3 class="ds-pr-title">A real control.</h3><p class="ds-pr-body">This button opens a native popover. Links navigate; disabled buttons remain disabled.</p><PaperAction popovertarget="paper-action-note" popovertargetaction="hide" variant="signal">Close note</PaperAction></div><CodeExample title="PaperAction · links and controls" code={`---
import PaperAction from '../components/ui/PaperAction.astro';
---
<PaperAction href="/vault/architecture/" variant="paper">Explore the system</PaperAction>
<PaperAction href="/vault/search/" variant="signal">Try the example</PaperAction>
<PaperAction href="/vault/guardrails/" variant="outline">Read the checks</PaperAction>
<PaperAction type="button" disabled>Unavailable</PaperAction>`} /><SourceFiles paths={['components/ui/PaperAction.astro','components/ui/paper-action.css','styles/tokens/buttons.css']} /><span class="ds-eyebrow">Blueprint</span><p>The fixed structure, drawn over the live component: slots, how each part sizes and the token behind every size. The spec below is what an agent reads and edits, and <code>npm run blueprint:check</code> fails if the component stops matching it.</p><BlueprintView id="paper-action"><PaperAction type="button" variant="paper">Add a note<span slot="icon">+</span></PaperAction></BlueprintView><CodeExample title="paper-action.ts · blueprint spec" code={source('blueprints/paper-action.ts')} /><a class="ds-text-link" href="/lab/blueprints/paper-action/">Its page in the blueprint lab</a><p class="ds-note">Minimum target height follows --nt-hit. Keyboard focus has its own visible ring; hover and press transforms stop under reduced motion. Use links for destinations and buttons for actions. Do not make disabled links imitate disabled controls.</p></article>
          <article class="ds-component"><div class="ds-component-head"><h3>Monogram</h3><span class="ds-badge">Astro · inline SVG</span></div><p>The SJ mark: two nets between one pair of pins. Size its container. Intro modes: session, always or none. The gloss prop (second specimen) adds the hero finish: a graded S stroke and a soft signal glow under the J, from <code>--pp-gloss-0</code>, <code>--pp-gloss-1</code> and <code>--pp-gloss-glow</code>.</p><div class="ds-stage ds-monogram"><Monogram intro="none" /><Monogram intro="none" gloss /></div><CodeExample title="Monogram · usage" code={`---
import Monogram from '../components/ui/Monogram.astro';\n---\n<div style="height: var(--hf-space-16)"><Monogram intro="session" /></div>`} /><SourceFiles paths={['components/ui/Monogram.astro']} /></article>
          <article id="paper-nav" class="ds-component"><div class="ds-component-head"><h3>PaperNav</h3><span class="ds-badge">Astro · site chrome</span></div><p>The site header, live at the top of this page. Three zones on one bar: who (the Monogram, the name, a mono role line), where (the six pages in Manrope at --pp-fs-nav), and tools (the search field, an icon theme toggle and the CV as a compact PixelButton). The current page carries a signal tab that sits on the bar's hairline, and the hairline is drawn only once the page scrolls under the bar. On a phone the pages fold into a menu list with the CV at its foot.</p><CodeExample title="PaperNav · through the layout" code={`<PaperLayout title="…" current="writing">…</PaperLayout>
<!-- current is the page's lower-case nav label, which sets aria-current and the tab -->`} /><SourceFiles paths={['components/layout/PaperNav.astro','data/home.ts','styles/tokens/paper.css']} /><p class="ds-note">Links come from HEADER_LINKS in data/home.ts: pages only. Home sections and side pages live in the footer. Tokens: --pp-nav-h, --pp-nav-mark-h, --pp-nav-blur, --pp-nav-tab, --pp-nav-icon, --pp-fs-nav, --pp-w-nav.</p></article>
          <article id="site-search" class="ds-component"><div class="ds-component-head"><h3>SiteSearch</h3><span class="ds-badge">Astro · site chrome</span></div><p>The search in the bar, live at the top of this page: press / or Ctrl K (Cmd K on a Mac), or click the field. It opens a native dialog, a notepad sheet with a hairline edge and the pixel button's hard step shadow, under the bar. Results come from the site index the build writes (/site-index.json), so a new page is searchable the build it appears. Each result is the page's name with the typed words underlined in the signal, its address in mono and its part of the site. The chosen row carries the nav's orange tab on the raised paper face. When the name does not hold the words, the description that does is shown. Under 1280 px the field folds to its glass. The sheet rises with transform and opacity only, and not at all under reduced motion.</p><CodeExample title="SiteSearch · in the bar" code={`---
import SiteSearch from './SiteSearch.astro';
---
<div class="tools"><SiteSearch /> …</div>`} /><SourceFiles paths={['components/layout/SiteSearch.astro','components/layout/site-search.ts','components/layout/search-results.ts','components/layout/site-search.css','lib/site-index/search.ts']} /><p class="ds-note">Tokens: --pp-search-field-w, --pp-search-w, --pp-search-top, --pp-search-list-h. The same index draws <a href="/site-index/">the site index</a> (--pp-index-indent, --pp-index-w). <code>npm run site:index:selftest</code> holds the ranking and proves a new folder of pages is picked up.</p></article>
          <article id="paper-footer" class="ds-component"><div class="ds-component-head"><h3>PaperFooter</h3><span class="ds-badge">Astro · site chrome</span></div><p>The site footer, live at the bottom of this page, laid out as the title block of an engineering drawing. The sheet is a who column (Monogram, pitch, the hand-written line) and three link indexes, transparent and split by hairlines. Under it runs one row of labelled cells (drawn by, part no., rev, edition, sheet, ©) ending in Back to top. At tablet width the who column spans the top, and on a phone the indexes go two up and the cells become a two-column table.</p><CodeExample title="PaperFooter · data" code={`// data/footer.ts
FOOTER_GROUPS  // [{ label: '// pages', links: [...] }, ...]
TITLE_BLOCK    // [{ label: 'Part no.', value: 'JUAN-SOC-1999-X1' }, ...]`} /><SourceFiles paths={['components/layout/PaperFooter.astro','data/footer.ts','styles/tokens/paper.css']} /><p class="ds-note">Elsewhere links (GitHub, LinkedIn, email, CV) come from CONTACT and IDENTITY in data/site.ts. Back to top targets #site-top on the header, so it works without script. Tokens: --pp-foot-mark-h, --pp-foot-brand-w, --pp-fs-micro, --pp-tracking-micro.</p></article>
          <article class="ds-component"><div class="ds-component-head"><h3>FigureCanvas</h3><span class="ds-badge">React · client:visible</span></div><p>One figure registry for the home city, post covers, lab and anatomy. The wrapper sets the size; the figure supplies its accessible description. Public examples keep the audit readout hidden.</p><div class="ds-figure"><FigureCanvas id="system-stack" client:visible /></div><CodeExample title="FigureCanvas · usage" code={figureRecipe} /><SourceFiles paths={['components/ui/FigureCanvas.tsx','components/ui/figure-canvas.css']} /><p class="ds-note">Dependencies: hooks/useFigureLoop.ts and the figures/ registry and kit. Renderer source alone does not include a drawing. <a href="/lab/">Find figures in the lab</a></p></article>
          <article class="ds-component"><div class="ds-component-head"><h3>FigurePlate</h3><span class="ds-badge">React · static</span></div><p>A baked figure: drawn ahead of time by a playbook's kernel in the same token palette, registered by the manifest the kernel writes (figures/plates/&lt;id&gt;.json), audited by figures:audit and shown by id, never by an image path. It fills its host and swaps its light and dark plate with the theme, like a colour token. Live parts (the library's binders, a live figure laid on top) are placed by the plate's anchors. This is the library's wall unit.</p><div class="ds-figure" style="position: relative; aspect-ratio: 1"><FigurePlate id="library-wall" /></div><SourceFiles paths={['components/ui/FigurePlate.tsx','components/ui/figure-plate.css','figures/plates/registry.ts']} /><p class="ds-note">Dependencies: the plate manifests and their images in public/. Re-bake a plate with its kernel (the library's is npm run library-art) whenever a token it names changes: the audit fails it as stale until then.</p></article>
          <article class="ds-component"><div class="ds-component-head"><h3>Desk scene materials</h3><span class="ds-badge">palette.ts · deskTones</span></div><p>True material colours for the home page's dev-desk scene (desk, monitors, keyboard, gaming PC, chair, server racks, screen UI). The scene is not recoloured by the page filter; greys stay in the night palette's cool neutral band, and its one accent is read from --nt-signal at run time (signal orange on paper pages).</p><div class="ds-desk-swatches">{Object.entries(deskTones).map(([name, hex]) => <span class="ds-desk-swatch"><i style={`background:${hex}`}></i><code>{name}</code></span>)}</div><SourceFiles paths={['styles/tokens/palette.ts', 'figures/kit/ink.ts']} /></article>
          <article class="ds-component"><div class="ds-component-head"><h3>Sticker</h3><span class="ds-badge">Astro · static SVG</span></div><p>A hand-inked die-cut sticker pressed on the paper: wobbled line, cream border, soft shadow, optional tape. Art lives in figures/kit/stickers.ts; colours and weights come from the --pp-sticker-* tokens (edge, ink, fill, fill-2, shadow, tape, size, line, line-bold, line-thin); classes o (bold outline), i (ink), t (hatching), h (gloss), f, g, a, k. It needs the #sticker-cut filter on the page (see PaperContact).</p><div class="ds-hardware"><div><Sticker kind="piano" tilt={-4} /></div><div><Sticker kind="swimming" tilt={4} taped /></div></div><SourceFiles paths={['components/ui/Sticker.astro', 'figures/kit/stickers.ts']} /><span class="ds-eyebrow">Blueprint</span><BlueprintView id="sticker"><Sticker kind="piano" /></BlueprintView><CodeExample title="sticker.ts · blueprint spec" code={source('blueprints/sticker.ts')} /><a class="ds-text-link" href="/lab/blueprints/sticker/">Its page in the blueprint lab</a></article>
          <article class="ds-component"><div class="ds-component-head"><h3>HardwareIcon</h3><span class="ds-badge">React · static SVG</span></div><p>Exportable hardware geometry shared with the hardware atlas. Supports isometric and wireframe presentation, view selection and opened parts.</p><div class="ds-hardware"><div><HardwareIcon kind="processor" /><span>isometric</span></div><div><HardwareIcon kind="processor" mode="wireframe" /><span>wireframe</span></div></div><CodeExample title="HardwareIcon · usage" code={`---
import HardwareIcon from '../components/ui/HardwareIcon';\n---\n<div style="width: var(--nt-thumb-min); aspect-ratio: 1">\n  <HardwareIcon kind="processor" mode="wireframe" />\n</div>`} /><SourceFiles paths={['components/ui/HardwareIcon.tsx']} /><p class="ds-note">Dependencies: figures/kit/hardware/ and data/hardware.ts. <a href="/lab/icon-kit/">Open the hardware atlas for the geometry library and exports</a></p></article>
          <article class="ds-component"><div class="ds-component-head"><h3>SlideIcon</h3><span class="ds-badge">React · static SVG</span></div><p>An extensible set of flat and restrained 2.5D marks for presentations, with source-attached accents and per-icon size proofs. Dark/light ink and teal-accent/monochrome treatments share the same geometry as the downloadable SVGs.</p><div class="ds-slide-icons"><div class="page-ink"><SlideIcon id="processor" /></div><div class="page-ink"><SlideIcon id="satellite" accent={false} /></div><div class="ds-slide-paper"><SlideIcon id="notebook" tone="paper" /></div></div><CodeExample title="SlideIcon · usage" code={`---
import SlideIcon from '../components/ui/SlideIcon';
---
<div style="width: var(--hf-space-16); aspect-ratio: 1">
  <SlideIcon id="processor" tone="night" accent={true} />
</div>`} /><SourceFiles paths={['components/ui/SlideIcon.tsx']} /><p class="ds-note">Dependencies: figures/kit/slides/ and data/slide-icons.ts. <a href="/lab/slide-icons/">Simple slide marks and the complete export set</a></p></article>
          <article class="ds-component"><div class="ds-component-head"><h3>PostGrid</h3><span class="ds-badge">React · client:visible</span></div><p>The same filter pills, hairline cards, pointer spotlight and live covers used on writing and learn. These are the two newest real posts.</p><div class="ds-post-grid"><PostGrid posts={posts} labels={CATEGORY_LABEL} client:visible /></div><CodeExample title="PostGrid · usage with real post data" code={postRecipe} /><SourceFiles paths={['components/writing/PostGrid.tsx','components/writing/post-grid.css']} /><p class="ds-note">Dependencies: writing/types.ts, FigureCanvas and its registry. Filters expose aria-pressed; cards remain links without JavaScript.</p></article>
        </section>

        <section id="legacy" data-ds-section class="ds-section">
          <SectionHead label="// 07 · legacy library" title="Keep the old parts findable." lead="The earlier lime, typewriter, cockpit and lofi system is preserved here. Use the night system above for current pages; this library documents the existing older components." />
          <details class="ds-disclosure ds-legacy"><summary>Open legacy component previews & source</summary><LegacyGallery /></details>
          <details class="ds-disclosure"><summary>Legacy colour tokens · {colors.filter((t) => !t.name.startsWith('--nt-')).length} variables</summary><div class="ds-swatches">{colors.filter((t) => !t.name.startsWith('--nt-')).map((t) => <button type="button" class="ds-swatch" data-copy-token={`var(${t.name})`}><span class="ds-chip" style={`background: var(${t.name})`} aria-hidden="true"></span><span class="ds-token-name">{t.name}</span><span class="ds-token-value">{t.value}</span><span class="ds-copy-hint">Copy variable</span></button>)}</div></details>
          <div class="ds-callout"><span class="nt-label">Keeping this current</span><p>Token inventories and source panels are generated from the same files the site builds with. Add a live preview here whenever a new shared component is introduced, and link page-specific systems to their production pages.</p></div>
        </section>
        <div class="ds-end"><span class="nt-label">// end of reference</span><a class="ds-text-link" href="#overview">Back to overview ↑</a></div>
      </div>
    </div>
