---
import { getCollection } from 'astro:content';
import NightPage from '../layouts/NightPage.astro';
import NightNav from '../components/layout/NightNav.astro';
import NightFooter from '../components/layout/NightFooter.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import Monogram from '../components/ui/Monogram.astro';
import FigureCanvas from '../components/ui/FigureCanvas';
import HardwareIcon from '../components/ui/HardwareIcon';
import SlideIcon from '../components/ui/SlideIcon';
import PostGrid from '../components/writing/PostGrid';
import type { PostSummary } from '../components/writing/types';
import { CATEGORY_LABEL } from '../data/writing';
import CodeExample from '../components/design-system/CodeExample.astro';
import SourceFiles from '../components/design-system/SourceFiles.astro';
import LegacyGallery from '../components/design-system/LegacyGallery.astro';
import { tokens, tokenFiles, colorGroups, source, pageRecipe, readingRecipe, figureRecipe, trackerRecipe } from '../components/design-system/reference';
import '../styles/design-system.css';
import '../styles/night-prose.css';
import '../styles/learn-paper.css';

const colors = tokens('colors');
const sizes = tokens('typography').filter((t) => t.name.startsWith('--nt-fs'));
const sections = [ ['overview', 'Overview'], ['foundations', 'Foundations'], ['type', 'Typography'], ['layout', 'Layout & motion'], ['patterns', 'Page patterns'], ['components', 'Components'], ['legacy', 'Legacy library'] ];
const pages = [
  { name: 'Home', href: '/', path: 'pages/index.astro', kind: 'System overview', note: 'Night chrome, large display type, live city and a DOM system map.' },
  { name: 'Writing', href: '/blog/', path: 'pages/blog/index.astro', kind: 'Browse & discover', note: 'Featured pages, filterable post cards and the lesson log.' },
  { name: 'Learn', href: '/learn/', path: 'pages/learn/index.astro', kind: 'Read & understand', note: 'Night index; article bodies follow the reader’s light or dark preference.' },
  { name: 'Trackers', href: '/trackers/', path: 'layouts/TrackerLayout.astro', kind: 'Compare releases', note: 'Shared tracker navigation, a left version rail and centered release detail.' },
  { name: 'Lab', href: '/lab/', path: 'pages/lab/index.astro', kind: 'Explore & reuse', note: 'Seeded figure templates and an exportable hardware icon kit.' },
  { name: 'Anatomy', href: '/anatomy/chip-package/', path: 'pages/anatomy/chip-package.astro', kind: 'Inspect a system', note: 'Step controls and selectable parts beside an explanatory figure.' },
];
const entries = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 2);
const posts: PostSummary[] = entries.map((e) => ({ slug: e.slug, title: e.data.title, excerpt: e.data.excerpt, category: e.data.category, date: e.data.date.toISOString().slice(0, 10), read: e.data.readTime, cover: e.data.cover ?? null, href: e.data.externalUrl ?? `/blog/${e.slug}` }));
const postRecipe = `---\nimport PostGrid from '../components/writing/PostGrid';\nimport { CATEGORY_LABEL } from '../data/writing';\nconst posts = ${JSON.stringify(posts, null, 2)};\n---\n<PostGrid posts={posts} labels={CATEGORY_LABEL} client:visible />`;
---

<NightPage title="Design system · Juan Kok" description="The visual language of juansync.dev: live foundations, page patterns and shared components, with copyable usage and source code.">
  <a class="ds-skip" href="#overview">Skip to design system</a>
  <NightNav />
  <main data-design-system class="ds-page">
    <header class="nt-wrap ds-hero">
      <div class="ds-hero-copy">
        <span class="nt-label">// design_system · living reference</span>
        <h1>The parts.<br /><span>The whole system.</span></h1>
        <p>The visual language of juansync.dev, from a single teal signal to the pages built around it. Explore the patterns, try the components, take the code.</p>
        <div class="ds-actions"><a class="ds-button" href="#components">Explore components ↘</a><a class="ds-text-link" href="#patterns">Build a page →</a></div>
      </div>
      <div class="ds-specimen" aria-label="Site identity specimen">
        <div class="ds-specimen-top"><span>juan_kok</span><span>night / 2026</span></div>
        <div class="ds-mark"><Monogram intro="none" /></div>
        <div class="ds-specimen-bottom"><span>Near-black. Cool ink.<br />One teal signal.</span><span class="ds-signal-mark" aria-hidden="true">↗</span></div>
      </div>
    </header>

    <div class="nt-wrap ds-shell">
      <aside class="ds-index"><nav aria-label="On this page"><span class="ds-eyebrow">On this page</span>{sections.map(([id, label], i) => <a href={`#${id}`} data-section-link><span>{String(i + 1).padStart(2, '0')}</span>{label}</a>)}</nav><p>Usage first.<br />Source when you need it.</p></aside>
      <div class="ds-content">
        <section id="overview" data-ds-section class="ds-section">
          <SectionHead label="// 01 · overview" title="One site. Several kinds of page." lead="A shared night shell connects the site. The content determines how much space, detail and motion belongs inside it." />
          <div class="ds-page-grid">{pages.map((page) => <article class="ds-page-card"><span class="ds-eyebrow">{page.kind}</span><h3><a href={page.href}>{page.name} ↗</a></h3><p>{page.note}</p><a class="ds-source-link" href={`https://github.com/JuanSync7/JuanSync7.github.io/blob/main/astro/src/${page.path}`}>View page source →</a></article>)}</div>
          <div class="ds-callout"><span class="nt-label">Start here</span><p>Use <code>--nt-*</code> for current pages, <code>NightPage</code> for the shell, and shared components for repeated patterns. The lime, typewriter and lofi library remains available below for older sections.</p></div>
        </section>

        <section id="foundations" data-ds-section class="ds-section">
          <SectionHead label="// 02 · foundations" title="Colour has a job." lead="Grounds recede, ink stays readable, teal marks an action or a point of attention. Hairlines separate content without turning every section into a filled card." />
          <p class="ds-note">Each swatch copies its CSS variable. Values and token lists come directly from the production token files at build time.</p>
          {colorGroups.map((group) => <div class="ds-token-group"><h3>{group.title}</h3><div class="ds-swatches">{colors.filter((t) => group.test(t.name)).map((t) => <button type="button" class="ds-swatch" data-copy-token={`var(${t.name})`} aria-label={`Copy var(${t.name})`}><span class="ds-chip" style={`background: var(${t.name})`} aria-hidden="true"></span><span class="ds-token-name">{t.name}</span><span class="ds-token-value">{t.value}</span><span class="ds-copy-hint">Copy variable ↗</span></button>)}</div></div>)}
          <CodeExample title="colors.css · all definitions" code={source('styles/tokens/colors.css')} />
        </section>

        <section id="type" data-ds-section class="ds-section">
          <SectionHead label="// 03 · typography" title="Three voices. One hierarchy." lead="Space Grotesk sets the direction. Geist does the reading. JetBrains Mono carries labels, navigation and code." />
          <div class="ds-fonts">{[['Space Grotesk', '--nt-display', 'Display / 500–600', 'A system worth understanding.'], ['Geist', '--nt-sans', 'Reading / 400–600', 'Clear words, room to think.'], ['JetBrains Mono', '--nt-mono', 'Labels & code / 400–700', '// evidence → understanding']].map(([name, token, role, text]) => <article class="ds-font"><span class="ds-eyebrow">{role}</span><h3>{name}</h3><p style={`font-family: var(${token})`}>{text}</p><button class="ds-token-button" type="button" data-copy-token={`var(${token})`}>{token} <span aria-hidden="true">↗</span></button></article>)}</div>
          <details class="ds-disclosure"><summary>Type scale · {sizes.length} sizes</summary><div class="ds-type-scale">{sizes.map((t) => <div><button type="button" class="ds-token-button" data-copy-token={`var(${t.name})`}>{t.name}</button><span class="ds-token-value">{t.value}</span><p style={`font-size: var(${t.name}); font-family: var(--nt-display); line-height: var(--nt-lh-heading)`}>Form follows understanding.</p></div>)}</div></details>
          <p class="ds-note">Base text: 16px at 1.6 line height; article prose: 17px. Introductory text uses a 640px measure; article bodies follow the page container. Headings use tighter line height and tracking. The full file also retains the older Special Elite and Caveat stacks.</p>
          <CodeExample title="typography.css · stacks, scale & rhythm" code={source('styles/tokens/typography.css')} />
        </section>

        <section id="layout" data-ds-section class="ds-section">
          <SectionHead label="// 04 · layout & motion" title="Space to read. Motion with purpose." lead="A 4px spacing scale, fluid gutters and generous section rhythm. Movement explains continuity; reduced motion removes it." />
          <div class="ds-layout-demo" aria-label="Layout specimen"><div class="ds-layout-label">.nt-wrap · max 1200px</div><div class="ds-layout-inner"><span>--nt-gutter<br />16–48px</span><div><span class="nt-label">.nt-section</span><h3>Let the content breathe.</h3><p>72–120px between sections. Use --nt-measure for text that should stay comfortably readable.</p></div></div></div>
          <div class="ds-spacing">{tokens('spacing').filter((t) => t.name.startsWith('--hf-space')).sort((a,b) => parseInt(a.value) - parseInt(b.value)).map((t) => <button type="button" data-copy-token={`var(${t.name})`}><span style={`height: var(${t.name})`} aria-hidden="true"></span><strong>{t.value}</strong><small>{t.name}</small></button>)}</div>
          <div class="ds-radii">{tokens('spacing').filter((t) => t.name.startsWith('--hf-radius')).map((t) => <button type="button" data-copy-token={`var(${t.name})`} style={`border-radius: var(${t.name})`}>{t.name.replace('--hf-radius-', '')}<small>{t.value}</small></button>)}</div>
          <div class="ds-callout"><span class="nt-label">Movement</span><p>NightPage uses Astro’s router. Pages crossfade; the navigation holds its position; matching post covers travel between views. The shared duration is <code>--nt-dur-morph</code> (460ms). The easing is <code>--nt-ease-out</code>. No scroll hijacking.</p></div>
          {tokenFiles.filter((file) => !['colors', 'typography'].includes(file)).map((file) => <CodeExample title={`${file}.css · all definitions`} code={source(`styles/tokens/${file}.css`)} />)}
          <details class="ds-disclosure"><summary>Complete layout, effect & motion token index</summary><div class="ds-token-list">{['spacing', 'gradients', 'motion'].flatMap((file) => tokens(file)).map((t) => <button type="button" data-copy-token={`var(${t.name})`}><code>{t.name}</code><span>{t.value}</span><span aria-hidden="true">↗</span></button>)}</div></details>
        </section>

        <section id="patterns" data-ds-section class="ds-section">
          <SectionHead label="// 05 · page patterns" title="Start with the right structure." lead="These are the layouts used by the site today. Copy a starting point, then keep the real components and their dependencies together." />
          <article class="ds-pattern"><div class="ds-pattern-title"><span class="ds-number">01</span><div><h3>The night page</h3><p>Home, writing, learn, lab and anatomy share NightPage, NightNav and NightFooter—the same chrome used here.</p></div></div><CodeExample title="Night page · starter.astro" code={pageRecipe} open /><SourceFiles paths={['layouts/NightPage.astro','layouts/NightLayout.astro','components/layout/NightNav.astro','components/layout/NightFooter.astro','styles/night.css']} /></article>
          <article class="ds-pattern"><div class="ds-pattern-title"><span class="ds-number">02</span><div><h3>The reading page</h3><p>Night chrome around a restrained article. Learn bodies become cream paper for light-mode readers; dark-mode readers keep the night ground. Code stays in a dark terminal in both.</p></div></div><div class="ds-reading-pair"><div class="ds-reading-sample"><span class="ds-eyebrow">Night / dark preference</span><h3>Evidence before confidence.</h3><p>Readable prose, quiet lines and a single highlight.</p></div><div class="ds-reading-sample ds-paper-sample"><span class="ds-eyebrow">Paper / light preference</span><h3>Evidence before confidence.</h3><p>The same hierarchy, on warm paper with darker ink.</p></div></div><CodeExample title="Reading body · usage" code={readingRecipe} /><SourceFiles paths={['styles/night-prose.css','styles/learn-paper.css']} /></article>
          <article class="ds-pattern"><div class="ds-pattern-title"><span class="ds-number">03</span><div><h3>The tracker</h3><p>A shared navigation row above a flush-left version-history rail and centered release details. Engines, frontier models and silicon use the same shell; each supplies its own content grid.</p></div></div><CodeExample title="Tracker · starter.astro" code={trackerRecipe} /><SourceFiles paths={['layouts/TrackerLayout.astro','components/trackers/_chrome.css','components/trackers/tracker-night.css']} /><a class="ds-text-link" href="/trackers/">See the trackers →</a></article>
          <article class="ds-pattern"><div class="ds-pattern-title"><span class="ds-number">04</span><div><h3>The interactive explorer</h3><p>Lab pairs figure templates with seeds and a hardware icon kit with export controls. Anatomy pairs a figure with step navigation and readable part descriptions. Keep labels and controls in the DOM; mount the drawing with FigureCanvas.</p></div></div><div class="ds-actions"><a class="ds-text-link" href="/lab/">Explore the lab →</a><a class="ds-text-link" href="/lab/icon-kit/">Hardware atlas →</a><a class="ds-text-link" href="/anatomy/chip-package/">Inspect a chip package →</a></div><SourceFiles paths={['pages/lab/index.astro','pages/lab/icon-kit.astro','pages/anatomy/chip-package.astro']} /></article>
        </section>

        <section id="components" data-ds-section class="ds-section">
          <SectionHead label="// 06 · shared components" title="Real components. Real examples." lead="These previews render the production components. Usage snippets assume the Astro + React project and imports relative to src/pages/. Source is included for inspection and reuse." />
          <article class="ds-component"><div class="ds-component-head"><h3>SectionHead</h3><span class="ds-badge">Astro · static</span></div><p>The mono label, two-tone heading and lead used across night pages. Use as="h1" once for the page title.</p><div class="ds-stage"><SectionHead label="// a shared pattern" title="Make it understandable." accent="Then make it work." lead="A familiar opening, wherever you are on the site." /></div><CodeExample title="SectionHead · usage" code={`---
import SectionHead from '../components/ui/SectionHead.astro';\n---\n<SectionHead label="// a shared pattern" title="Make it understandable." accent="Then make it work." lead="A familiar opening." />`} /><SourceFiles paths={['components/ui/SectionHead.astro']} /></article>
          <article class="ds-component"><div class="ds-component-head"><h3>Monogram</h3><span class="ds-badge">Astro · inline SVG</span></div><p>The SJ mark: two nets between one pair of pins. Size its container. Intro modes: session, always or none.</p><div class="ds-stage ds-monogram"><Monogram intro="none" /></div><CodeExample title="Monogram · usage" code={`---
import Monogram from '../components/ui/Monogram.astro';\n---\n<div style="height: var(--hf-space-16)"><Monogram intro="session" /></div>`} /><SourceFiles paths={['components/ui/Monogram.astro']} /></article>
          <article class="ds-component"><div class="ds-component-head"><h3>FigureCanvas</h3><span class="ds-badge">React · client:visible</span></div><p>One figure registry for the home city, post covers, lab and anatomy. The wrapper sets the size; the figure supplies its accessible description. Public examples keep the audit readout hidden.</p><div class="ds-figure"><FigureCanvas id="system-stack" client:visible /></div><CodeExample title="FigureCanvas · usage" code={figureRecipe} /><SourceFiles paths={['components/ui/FigureCanvas.tsx','components/ui/figure-canvas.css']} /><p class="ds-note">Dependencies: hooks/useFigureLoop.ts and the figures/ registry and kit. Renderer source alone does not include a drawing. <a href="/lab/">Find figures in the lab →</a></p></article>
          <article class="ds-component"><div class="ds-component-head"><h3>HardwareIcon</h3><span class="ds-badge">React · static SVG</span></div><p>Exportable hardware geometry shared with the hardware atlas. Supports isometric and wireframe presentation, view selection and opened parts.</p><div class="ds-hardware"><div><HardwareIcon kind="processor" /><span>isometric</span></div><div><HardwareIcon kind="processor" mode="wireframe" /><span>wireframe</span></div></div><CodeExample title="HardwareIcon · usage" code={`---
import HardwareIcon from '../components/ui/HardwareIcon';\n---\n<div style="width: var(--nt-thumb-min); aspect-ratio: 1">\n  <HardwareIcon kind="processor" mode="wireframe" />\n</div>`} /><SourceFiles paths={['components/ui/HardwareIcon.tsx']} /><p class="ds-note">Dependencies: figures/kit/hardware/ and data/hardware.ts. <a href="/lab/icon-kit/">Open the hardware atlas for the geometry library and exports →</a></p></article>
          <article class="ds-component"><div class="ds-component-head"><h3>SlideIcon</h3><span class="ds-badge">React · static SVG</span></div><p>Twenty-four simple marks for presentations. Dark/light ink and teal-accent/monochrome treatments share the same geometry as the downloadable SVGs.</p><div class="ds-slide-icons"><div><SlideIcon id="processor" /></div><div><SlideIcon id="satellite" accent={false} /></div><div class="ds-slide-paper"><SlideIcon id="notebook" tone="paper" /></div></div><CodeExample title="SlideIcon · usage" code={`---
import SlideIcon from '../components/ui/SlideIcon';
---
<div style="width: var(--hf-space-16); aspect-ratio: 1">
  <SlideIcon id="processor" tone="night" accent={true} />
</div>`} /><SourceFiles paths={['components/ui/SlideIcon.tsx']} /><p class="ds-note">Dependencies: figures/kit/slides/ and data/slide-icons.ts. <a href="/lab/slide-icons/">Simple slide marks and the complete export set →</a></p></article>
          <article class="ds-component"><div class="ds-component-head"><h3>PostGrid</h3><span class="ds-badge">React · client:visible</span></div><p>The same filter pills, hairline cards, pointer spotlight and live covers used on writing and learn. These are the two newest real posts.</p><div class="ds-post-grid"><PostGrid posts={posts} labels={CATEGORY_LABEL} client:visible /></div><CodeExample title="PostGrid · usage with real post data" code={postRecipe} /><SourceFiles paths={['components/writing/PostGrid.tsx','components/writing/post-grid.css']} /><p class="ds-note">Dependencies: writing/types.ts, FigureCanvas and its registry. Filters expose aria-pressed; cards remain links without JavaScript.</p></article>
        </section>

        <section id="legacy" data-ds-section class="ds-section">
          <SectionHead label="// 07 · legacy library" title="Keep the old parts findable." lead="The earlier lime, typewriter, cockpit and lofi system is preserved here. Use the night system above for current pages; this library documents the existing older components." />
          <details class="ds-disclosure ds-legacy"><summary>Open legacy component previews & source</summary><LegacyGallery /></details>
          <details class="ds-disclosure"><summary>Legacy colour tokens · {colors.filter((t) => !t.name.startsWith('--nt-')).length} variables</summary><div class="ds-swatches">{colors.filter((t) => !t.name.startsWith('--nt-')).map((t) => <button type="button" class="ds-swatch" data-copy-token={`var(${t.name})`}><span class="ds-chip" style={`background: var(${t.name})`} aria-hidden="true"></span><span class="ds-token-name">{t.name}</span><span class="ds-token-value">{t.value}</span><span class="ds-copy-hint">Copy variable ↗</span></button>)}</div></details>
          <div class="ds-callout"><span class="nt-label">Keeping this current</span><p>Token inventories and source panels are generated from the same files the site builds with. Add a live preview here whenever a new shared component is introduced, and link page-specific systems to their production pages.</p></div>
        </section>
        <div class="ds-end"><span class="nt-label">// end of reference</span><a class="ds-text-link" href="#overview">Back to overview ↑</a></div>
      </div>
    </div>
    <p class="ds-status" role="status" aria-live="polite" data-copy-status></p>
    <noscript><p class="nt-wrap ds-note">Copy buttons need JavaScript. Open any code panel, select the text and copy it manually.</p></noscript>
  </main>
  <NightFooter />
  <script>import '../components/design-system/design-system';</script>
</NightPage>
