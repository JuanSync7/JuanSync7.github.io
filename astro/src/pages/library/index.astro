---
import NightPage from '../../layouts/NightPage.astro';
import NightNav from '../../components/layout/NightNav.astro';
import NightFooter from '../../components/layout/NightFooter.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import PostGrid from '../../components/writing/PostGrid.tsx';
import { CATEGORY_LABEL, LIBRARY_COPY } from '../../data/writing';
import { BLOG, LIBRARY } from '../../data/library';
import { libraryCards } from '../../data/library-cards';

// Everything written, whatever its kind, in the same card grid as the blog. The blog features a
// few pieces; this page is the whole shelf.
const cards = await libraryCards();
---

<NightPage title={`${LIBRARY.label} · Juan Kok`} description={LIBRARY_COPY.body}>
  <NightNav current="blog" />
  <main>
    <section id="pieces" class="nt-wrap nt-section block">
      <a class="back" href={BLOG.href}>← {BLOG.label}</a>
      <SectionHead as="h1" label="// library" title={LIBRARY_COPY.title} lead={LIBRARY_COPY.body} />
      <nav class="kinds" aria-label="Kinds of writing">
        <a href={LIBRARY.articles}>{LIBRARY_COPY.articles}</a>
        <a href={LIBRARY.lessons}>{LIBRARY_COPY.lessons}</a>
      </nav>
      <PostGrid client:visible posts={cards} labels={CATEGORY_LABEL} cta="Read" />
    </section>
  </main>
  <NightFooter />
</NightPage>

<style>
  .block {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-8);
  }

  .back {
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-meta);
    color: var(--nt-ink-muted);
  }

  .kinds {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hf-space-6);
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-meta);
  }

  .kinds a {
    color: var(--nt-signal-text);
  }
</style>
