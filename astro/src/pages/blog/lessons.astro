---
import { getCollection } from 'astro:content';
import NightPage from '../../layouts/NightPage.astro';
import NightNav from '../../components/layout/NightNav.astro';
import NightFooter from '../../components/layout/NightFooter.astro';

// Every lesson, newest first, grouped by month: the writing page shows a slider of them;
// this is the whole log, set as plain type to read straight down.
const lessons = (await getCollection('lessons'))
  .map((l) => ({ iso: l.data.date.toISOString().slice(0, 10), tag: l.data.tag, title: l.data.title, why: l.data.why }))
  .sort((a, b) => b.iso.localeCompare(a.iso));
const month = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const day = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const groups: { label: string; items: typeof lessons }[] = [];
for (const l of lessons) {
  const label = month.format(new Date(`${l.iso}T00:00:00Z`));
  const last = groups[groups.length - 1];
  if (last && last.label === label) last.items.push(l);
  else groups.push({ label, items: [l] });
}
---

<NightPage title="Lessons · Juan Kok" description="One thing I learned, most days: every lesson in the log, newest first.">
  <NightNav current="writing" />
  <main class="nt-wrap nt-section page">
    <a class="back" href="/blog/#lessons">← Writing</a>
    <header class="head">
      <span class="label">// lessons</span>
      <h1>Every lesson</h1>
      <p>{lessons.length} lessons, newest first. One thing I learned, most days.</p>
    </header>
    {
      groups.map((g) => (
        <section class="month" aria-label={g.label}>
          <h2>{g.label}</h2>
          <ol>
            {g.items.map((l) => (
              <li>
                <p class="meta">
                  <time datetime={l.iso}>{day.format(new Date(`${l.iso}T00:00:00Z`))}</time>
                  <span class="tag">{l.tag}</span>
                </p>
                <h3>{l.title}</h3>
                <p class="why">{l.why}</p>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </main>
  <NightFooter />
</NightPage>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-12);
  }

  .back {
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-meta);
    color: var(--nt-ink-muted);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-4);
    max-width: var(--nt-measure);
  }

  .label,
  .tag {
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-meta);
    color: var(--nt-signal);
  }

  .head p {
    color: var(--nt-ink-soft);
  }

  .month {
    display: grid;
    grid-template-columns: minmax(0, var(--nt-thumb-min)) minmax(0, 1fr);
    gap: var(--hf-space-6);
    padding-top: var(--hf-space-8);
    border-top: 1px solid var(--nt-rule);
  }

  .month h2 {
    font-size: var(--nt-fs-h4);
  }

  ol {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-8);
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: var(--nt-measure);
  }

  .meta {
    display: flex;
    gap: var(--hf-space-3);
    margin-bottom: var(--hf-space-2);
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-meta);
    color: var(--nt-ink-muted);
  }

  h3 {
    margin-bottom: var(--hf-space-2);
    font-size: var(--nt-fs-intro);
  }

  .why {
    font-size: var(--nt-fs-small);
    color: var(--nt-ink-2);
  }

  @media (max-width: 720px) {
    .month {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
