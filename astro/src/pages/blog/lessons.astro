---
import { getCollection } from 'astro:content';
import NightPage from '../../layouts/NightPage.astro';
import NightNav from '../../components/layout/NightNav.astro';
import NightFooter from '../../components/layout/NightFooter.astro';
import LessonIndex from '../../components/writing/LessonIndex.tsx';
import type { CategorisedLesson } from '../../components/writing/types';
import { LESSON_CATEGORIES, categoryOf } from '../../data/lesson-categories';

// Every lesson, newest first: the writing page shows a slider of them; this is the whole log,
// set as plain type to read straight down, by month or by category.
const lessons: CategorisedLesson[] = (await getCollection('lessons'))
  .map((l) => ({
    iso: l.data.date.toISOString().slice(0, 10),
    tag: l.data.tag,
    category: categoryOf(l.data.tag),
    title: l.data.title,
    why: l.data.why,
  }))
  .sort((a, b) => b.iso.localeCompare(a.iso));
const categories = LESSON_CATEGORIES.map((c) => ({ id: c.id, label: c.label }));
---

<NightPage title="Lessons · Juan Kok" description="One thing I learned, most days: every lesson in the log, newest first.">
  <NightNav current="writing" />
  <main class="nt-wrap nt-section page">
    <a class="back" href="/blog/#lessons">← Writing</a>
    <header class="head">
      <span class="label">// lessons</span>
      <h1>Every lesson</h1>
      <p>{lessons.length} lessons, newest first, by month or by category. One thing I learned, most days.</p>
    </header>
    <LessonIndex client:load lessons={lessons} categories={categories} />
  </main>
  <NightFooter />
</NightPage>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-12);
  }

  .back {
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-meta);
    color: var(--nt-ink-muted);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-4);
    max-width: var(--nt-measure);
  }

  .label {
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-meta);
    color: var(--nt-signal);
  }

  .head p {
    color: var(--nt-ink-soft);
  }
</style>
