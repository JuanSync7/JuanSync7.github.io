---
import { getCollection } from 'astro:content';
import NightPage from '../../layouts/NightPage.astro';
import NightNav from '../../components/layout/NightNav.astro';
import NightFooter from '../../components/layout/NightFooter.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import WritingHero from '../../components/writing/WritingHero.astro';
import FeaturedBook from '../../components/writing/FeaturedBook.tsx';
import LessonLog, { WEEKS } from '../../components/writing/LessonLog.tsx';
import PostGrid from '../../components/writing/PostGrid.tsx';
import Trackers from '../../components/writing/Trackers.astro';
import Follow from '../../components/writing/Follow.astro';
import type { FeaturedPage, Lesson, PostSummary } from '../../components/writing/types';
import { CATEGORY_LABEL, FEATURED, LESSONS_COPY, POSTS_COPY } from '../../data/writing';

const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const show = (d: Date): string => fmt.format(d);

const entries = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const posts: PostSummary[] = entries.map((e) => ({
  slug: e.slug,
  title: e.data.title,
  excerpt: e.data.excerpt,
  category: e.data.category,
  date: show(e.data.date),
  read: e.data.readTime,
  cover: e.data.cover ?? null,
  href: e.data.externalUrl ?? `/blog/${e.slug}`,
}));

// Featured pages take title, date and read time from the post itself, so they can't drift.
const featured: FeaturedPage[] = FEATURED.items.flatMap((f) => {
  const post = entries.find((e) => e.slug === f.slug);
  if (!post) throw new Error(`featured post "${f.slug}" is not in the blog collection`);
  return [{ ...f, href: post.data.externalUrl ?? `/blog/${post.slug}`, title: post.data.title, date: show(post.data.date), read: post.data.readTime }];
});

// Only the lessons the field can show, a week of slack included for a reader whose today is
// after the build: the page must not grow with the whole log, which is on /blog/lessons/.
const all: Lesson[] = (await getCollection('lessons'))
  .map((l) => ({ iso: l.data.date.toISOString().slice(0, 10), tag: l.data.tag, title: l.data.title, why: l.data.why }))
  .sort((a, b) => b.iso.localeCompare(a.iso));
const reach = Date.parse(`${all[0]?.iso ?? '1970-01-01'}T00:00:00Z`) - (WEEKS + 1) * 7 * 86_400_000;
const lessons = all.filter((l) => Date.parse(`${l.iso}T00:00:00Z`) >= reach);
---

<NightPage title="Writing · Juan Kok" description="How AI inference works, from the transistor to the token, plus chip design and building with agents.">
  <link rel="alternate" type="application/rss+xml" title="Juan Kok · writing" href="/rss.xml" slot="head" />
  <NightNav current="writing" />
  <main>
    <WritingHero />

    <section id="featured" class="nt-wrap nt-section block">
      <SectionHead label="// featured" title={FEATURED.title} lead={FEATURED.body} />
      <FeaturedBook client:visible pages={featured} />
    </section>

    <section id="lessons" class="nt-wrap block">
      <SectionHead label="// lessons" title={LESSONS_COPY.title} lead={LESSONS_COPY.body} />
      <LessonLog client:visible lessons={lessons} note={LESSONS_COPY.key} allHref="/blog/lessons/" />
    </section>

    <section id="posts" class="nt-wrap nt-section block">
      <SectionHead label="// posts" title={POSTS_COPY.title} lead={POSTS_COPY.body} />
      <PostGrid client:visible posts={posts} labels={CATEGORY_LABEL} />
    </section>

    <Trackers />
    <Follow />
  </main>
  <NightFooter />
</NightPage>

<style>
  .block {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-8);
  }
</style>
