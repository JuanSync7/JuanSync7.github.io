---
import NightPage from '../../layouts/NightPage.astro';
import NightNav from '../../components/layout/NightNav.astro';
import NightFooter from '../../components/layout/NightFooter.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import FormatCard from '../../components/formats/FormatCard.astro';
import PageTypeCard from '../../components/formats/PageTypeCard.astro';
import { FORMAT_AREAS, FORMAT_FAMILIES, FORMATS_SUMMARY, PAGE_TYPES } from '../../data/formats';
import '../../styles/night-prose.css';

// Every format my tools and agents write, grouped by area, then the frontmatter of every kind of vault page.
// The vault owns the list and works out each skeleton. Every value is set as text.
// A family with no records of its own is the vault's pages: its page types follow it in its area.
const groups = FORMAT_AREAS.map((area) => {
  const families = FORMAT_FAMILIES.filter((family) => family.area === area.id);
  const pages = families.some((family) => !family.records.length) ? PAGE_TYPES : [];
  return { ...area, families, pages, count: families.length + pages.length };
}).filter((group) => group.count);
const lead = 'Every record my tools and agents write says which format it is and which version. This is the one list of those formats, kept in my vault.';
---

<NightPage title="Formats · Juan Kok" description={lead}>
  <NightNav />
  <main>
    <section class="nt-wrap nt-section register" data-format-register>
      <SectionHead as="h1" label="// formats" title="Formats" lead={lead}>
        <p class="why">
          Agents build faster than anyone can review by hand, so what holds the work together is the shape of what they
          write. Each format here has a name, a version and one place it is defined. A project pins the version it writes,
          and a check in the vault fails when code writes a format this list does not hold. Formats from my other projects
          are copied in with the commit they came from, until those projects take theirs from here.
        </p>
        <p class="why">{FORMATS_SUMMARY} Each format shows its skeleton. Open its fields for the notes on each one.</p>
      </SectionHead>
      <form class="search" data-format-search role="search" hidden>
        <label>
          Search the formats
          <input type="search" name="q" placeholder="For example, milestone or owner" autocomplete="off" />
        </label>
        <p class="result" data-format-result role="status" aria-live="polite" aria-atomic="true"></p>
      </form>
      <p class="none" data-format-empty hidden>No format has those words. Try fewer of them.</p>
      {
        groups.map((group) => (
          <section class="group" data-format-group aria-label={group.title}>
            <header>
              <h2>{group.title}</h2>
              <p>{group.count} listed</p>
              <p>{group.what}</p>
            </header>
            <ul class="cards">
              {group.families.map((family) => (
                <FormatCard family={family} />
              ))}
              {group.pages.map((type) => (
                <PageTypeCard type={type} />
              ))}
            </ul>
          </section>
        ))
      }
    </section>
  </main>
  <NightFooter />
</NightPage>

<script>
  import { mountFormatSearch } from '../../components/formats/formatSearch';
  let cleanup: (() => void) | undefined;
  const mount = () => {
    cleanup?.();
    const root = document.querySelector<HTMLElement>('[data-format-register]');
    cleanup = root ? mountFormatSearch(root) : undefined;
  };
  document.addEventListener('astro:page-load', mount);
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>

<style>
  .register {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-10);
  }

  .register [hidden] {
    display: none;
  }

  .why {
    max-width: var(--nt-measure);
    color: var(--nt-ink-2);
  }

  .search {
    display: grid;
    gap: var(--hf-space-3);
    max-width: var(--nt-measure);
  }

  .search label {
    display: grid;
    gap: var(--hf-space-2);
    font-size: var(--nt-fs-small);
  }

  .search input {
    color: var(--nt-ink);
    background: var(--nt-ground);
    border: 1px solid var(--nt-rule);
    padding: var(--hf-space-3);
    border-radius: 0;
    font: inherit;
  }

  .result {
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-meta);
    color: var(--nt-ink-muted);
  }

  .group {
    display: grid;
    grid-template-columns: minmax(0, var(--nt-thumb-min)) minmax(0, 1fr);
    gap: var(--hf-space-6);
    padding-top: var(--hf-space-8);
    border-top: 1px solid var(--nt-rule);
  }

  .group > header h2 {
    font-size: var(--nt-fs-h4);
  }

  .group > header p {
    margin-top: var(--hf-space-2);
    font-size: var(--nt-fs-meta);
    color: var(--nt-ink-muted);
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-12);
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 0;
  }

  .none {
    color: var(--nt-ink-muted);
  }

  @media (max-width: 720px) {
    .group {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
