---
import NightPage from '../../layouts/NightPage.astro';
import NightNav from '../../components/layout/NightNav.astro';
import NightFooter from '../../components/layout/NightFooter.astro';
import AnatomyExplorer from '../../components/anatomy/AnatomyExplorer.tsx';
import PackageOpen from '../../components/anatomy/PackageOpen.tsx';
import { ACCELERATOR_PARTS, PACKAGE_STEPS } from '../../data/anatomy';
---

<NightPage
  title="Inside a chip package · Juan Kok"
  description="A phone processor's package taken apart one layer at a time, then an AI accelerator's opened up: memory on top, and memory beside."
>
  <NightNav current="anatomy" />
  <main class="nt-wrap nt-section page">
    <header class="head">
      <span class="label">// anatomy</span>
      <h1>Inside a chip package</h1>
      <p>
        The part of a chip you never see. Step down through the package of a phone's processor: one die, no lid, and its
        memory stacked right on top. Use the arrows, a number key, or pick a part.
      </p>
    </header>
    <AnatomyExplorer client:visible steps={PACKAGE_STEPS} figure="chip-anatomy" />
    <header class="head">
      <span class="label">// open it up</span>
      <h2>An accelerator, opened</h2>
      <p>
        A phone stacks its memory on top of the processor and reaches it through a ring of a few hundred balls. The largest
        AI chips need thousands of memory wires, so their memory sits beside the compute dies on one slab of silicon: two
        dies joined edge to edge, eight memory stacks along their sides. Click it to close it or open it again, or point at
        a part.
      </p>
    </header>
    <PackageOpen client:visible parts={ACCELERATOR_PARTS} />
  </main>
  <NightFooter />
</NightPage>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-12);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-4);
    max-width: var(--nt-measure);
  }

  .label {
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-meta);
    color: var(--nt-signal);
  }

  .head p {
    color: var(--nt-ink-soft);
  }
</style>
