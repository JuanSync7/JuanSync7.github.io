---
import NightPage from '../../layouts/NightPage.astro';
import NightNav from '../../components/layout/NightNav.astro';
import NightFooter from '../../components/layout/NightFooter.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import PostGrid from '../../components/writing/PostGrid.tsx';
import Trackers from '../../components/writing/Trackers.astro';
import { LEARN_SUBJECTS } from '../../content/config';
import { LEARN_COPY, LEARN_SUBJECT, LEARN_SUBJECT_LABEL, learnCard, learnEntries } from '../../data/learn';

// Every field guide, newest first, in the same card grid as the writing page, filtered by
// subject. Each subject names the tracker that follows it week by week.
const entries = await learnEntries();
const cards = entries.map(learnCard);
const subjects = LEARN_SUBJECTS.map((s) => ({ ...LEARN_SUBJECT[s], count: entries.filter((e) => e.data.subject === s).length }));
---

<NightPage title="Learn · Juan Kok" description={LEARN_COPY.body}>
  <NightNav current="learn" />
  <main>
    <section class="nt-wrap nt-section block">
      <a class="back" href="/blog/">← Writing</a>
      <SectionHead as="h1" label="// learn" title={LEARN_COPY.title} lead={LEARN_COPY.body} />
      <ul class="subjects">
        {subjects.map((s) => (
          <li>
            <span class="subject">{s.label}</span>
            <span class="count">{s.count} {s.count === 1 ? 'guide' : 'guides'}</span>
            <a href={s.tracker.href}>{s.tracker.name} tracker →</a>
          </li>
        ))}
      </ul>
      <PostGrid client:visible posts={cards} labels={LEARN_SUBJECT_LABEL} cta="Read the guide →" />
    </section>
    <Trackers />
  </main>
  <NightFooter />
</NightPage>

<style>
  .block {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-8);
  }

  .back {
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-meta);
    color: var(--nt-ink-muted);
  }

  .subjects {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hf-space-3) var(--hf-space-8);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-meta);
  }

  .subjects li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hf-space-3);
  }

  .subject {
    color: var(--nt-signal);
  }

  .count {
    color: var(--nt-ink-muted);
  }

  .subjects a {
    color: var(--nt-ink-2);
  }
</style>
