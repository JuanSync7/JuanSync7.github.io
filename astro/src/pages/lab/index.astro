---
import slideStats from '../../data/slide-stats.json';
import NightPage from '../../layouts/NightPage.astro';
import NightNav from '../../components/layout/NightNav.astro';
import NightFooter from '../../components/layout/NightFooter.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import Monogram from '../../components/ui/Monogram.astro';
import FigureCanvas from '../../components/ui/FigureCanvas.tsx';
import LabCard from '../../components/lab/LabCard.astro';
import IconCycle from '../../components/lab/IconCycle.astro';
import { ALL } from '../../blueprints';
import { loadTemplate, templateIds } from '../../figures/registry';

// Every template, read from the registry, so a new file in src/figures/templates shows up
// here with nothing else to edit. Each card shows one instance; seed 1 everywhere would
// make the page read as one style, so the seed is the card's position, offset.
const templates = await Promise.all(
  templateIds().map(async (id, i) => {
    const t = await loadTemplate(id);
    const seed = 7 + i * 31;
    return { id, title: t.title, idea: t.idea, style: t.style, seed, instance: `${id}~${seed}`, variant: t.instance(seed).variant };
  }),
);

// The pieces with no seed: one fixed reference each, shown by its own drawing.
type Art = 'monogram' | 'sheet' | 'icons' | { figure: string };
const tools: { href: string; kind: string; title: string; blurb: string; cta: string; notes: [string, string]; art: Art }[] = [
  {
    href: '/design-system/',
    kind: 'design system',
    title: 'The design system',
    blurb: 'The tokens, page patterns and components this site is built from, each live on the page with its code.',
    cta: 'Open the design system',
    notes: ['tokens · patterns · components', 'WCAG 2.2 in both themes'],
    art: 'monogram',
  },
  {
    href: '/lab/blueprints/',
    kind: 'blueprints',
    title: 'Blueprints',
    blurb: 'Every component and page drawn as an engineering sheet. Each part is numbered and each size is named by the token that sets it.',
    cta: 'Read the blueprints',
    notes: [`${ALL.length} blueprints`, 'measured at 1280 and 390 px'],
    art: 'sheet',
  },
  {
    href: '/lab/lego/',
    kind: 'lego',
    title: 'Designing in LEGO',
    blurb: "From an engineer's drawing of the real part to a plan in shapes, then bricks, each one checked before it is drawn.",
    cta: 'See how a model is built',
    notes: ['first-angle drawing first', 'every brick checked'],
    art: { figure: 'lego-f1' },
  },
  {
    href: '/lab/slide-icons/',
    kind: 'slide icons',
    title: 'Slide icons',
    blurb: 'Flat marks for slides and web pages, in a quiet ink with one complete feature in the accent. Search them and take the SVGs.',
    cta: 'Browse the icons',
    notes: [`${slideStats.count} marks`, 'SVG · transparent'],
    art: 'icons',
  },
  {
    href: '/lab/palette/',
    kind: 'palette',
    title: 'The palette studio',
    blurb: 'Pick a ground, an ink and an accent, spend them 60/30/10 on a sample site and three drawings, and take the system away as a prompt or as code.',
    cta: 'Pick a palette',
    notes: ['60 · 30 · 10', 'WCAG 2.2, both themes'],
    art: { figure: 'swatch-room' },
  },
  {
    href: '/lab/icon-kit/',
    kind: 'hardware atlas',
    title: 'The hardware atlas',
    blurb: 'Twelve physical assemblies drawn in one language. Switch the view, lift the layers and download every SVG.',
    cta: 'Open the atlas',
    notes: ['12 assemblies', '24 SVG icons'],
    art: { figure: 'hardware-atlas~7' },
  },
  {
    href: '/anatomy/chip-package/',
    kind: 'anatomy',
    title: 'Inside a chip package',
    blurb: "A phone processor's package taken apart one layer at a time, then an accelerator opened up and one die cut down to its transistors.",
    cta: 'Step inside',
    notes: ['one layer at a time', 'lid to transistor'],
    art: { figure: 'chip-anatomy' },
  },
];
---

<NightPage title="Lab · Juan Kok" description="The lab: the kits this site is built with, and the figure templates that draw a different picture from every seed.">
  <NightNav current="lab" />
  <main class="nt-wrap nt-section lab-page">
    <header class="lab-head">
      <span class="lab-label">// lab</span>
      <h1>The lab</h1>
      <p>
        Where the drawings on this site are made and tested. Six pieces are fixed references the site is built and checked against. The rest
        are figure templates, which draw a different picture from every seed.
      </p>
    </header>
    <div class="lab-hero">
      <FigureCanvas client:visible id="lab-room" />
    </div>

    <section class="lab-section lab-tools" aria-label="Tools">
      <SectionHead
        label="// 01 · tools"
        title="Kits and references."
        accent="No seed."
        lead="Each one is fixed. It is the reference a page, a drawing or a model is held up against."
      />
      <ul class="lab-list">
        {
          tools.map((t) => (
            <li>
              <LabCard href={t.href} meta={[t.kind]} title={t.title} blurb={t.blurb} cta={t.cta} notes={t.notes}>
                {t.art === 'monogram' ? (
                  <div class="lab-mark">
                    <Monogram intro="always" />
                  </div>
                ) : t.art === 'sheet' ? (
                  <div class="lab-sheet">
                    <img class="page-ink" src="/blueprints/home.png" alt="" loading="lazy" decoding="async" />
                  </div>
                ) : t.art === 'icons' ? (
                  <IconCycle />
                ) : (
                  <FigureCanvas client:visible id={t.art.figure} />
                )}
              </LabCard>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="lab-section lab-seeded" aria-label="Figure templates">
      <SectionHead
        label="// 02 · seeded"
        title="Figure templates."
        accent="A new picture from every seed."
        lead="Each template is a set of rules for drawing one kind of picture. A seed picks the choices (which object, which angle, how many parts), seeded noise shapes the detail, and the template's grammar keeps every combination deliberate. Open one to walk its seeds."
      />
      <p class="lab-count">{templates.length} templates · 1,000,000,000 seeds each</p>
      <ul class="lab-list">
        {
          templates.map((t) => (
            <li>
              <LabCard
                href={`/lab/${t.id}/`}
                meta={[t.style, t.instance]}
                title={t.title}
                blurb={t.idea}
                cta="Walk its seeds"
                notes={[t.variant, `seed ${t.seed}`]}
              >
                <FigureCanvas
                  client:visible
                  id={t.instance}
                  data={t.id === 'pixel-still' ? { appearance: 'colour', view: 'isometric', angle: 135 } : undefined}
                />
              </LabCard>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <NightFooter />
</NightPage>

<style>
  .lab-head {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-3);
    max-width: var(--nt-measure);
    margin-bottom: var(--hf-space-8);
  }
  .lab-label {
    color: var(--nt-signal-text);
  }
  .lab-count {
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-meta);
    color: var(--nt-ink-muted);
  }
  .lab-head h1 {
    font-size: var(--nt-fs-h1);
    letter-spacing: var(--nt-tracking-display);
    line-height: var(--nt-lh-heading);
  }
  .lab-head p {
    color: var(--nt-ink-soft);
  }
  .lab-hero {
    aspect-ratio: 3 / 2;
    margin-bottom: var(--hf-space-16);
  }
  @media (max-width: 860px) {
    .lab-hero {
      aspect-ratio: 4 / 3;
    }
  }
  .lab-section {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-8);
    margin-bottom: var(--hf-space-16);
  }
  .lab-list {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lab-mark {
    position: absolute;
    inset: var(--hf-space-8);
    display: flex;
    justify-content: center;
  }
  .lab-sheet {
    height: 100%;
    overflow: hidden;
  }
  .lab-sheet img {
    display: block;
    width: 160%;
    max-width: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .lab-sheet img {
      animation: lab-sheet-pan var(--nt-dur-pan) ease-in-out infinite alternate;
    }
  }
  @keyframes lab-sheet-pan {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(-37.5%, -18%);
    }
  }
</style>
