---
import NightPage from '../../layouts/NightPage.astro';
import NightNav from '../../components/layout/NightNav.astro';
import NightFooter from '../../components/layout/NightFooter.astro';
import Repos from '../../components/home/Repos.astro';
import ExperienceTimeline from '../../components/about/ExperienceTimeline.astro';
import { PROFILE } from '../../data/profile';
import { CASES, THINKING } from '../../data/home';
import { VAULT_STATEMENT } from '../../data/about';
import '../../styles/night-prose.css';

const cv = PROFILE.cv_file;
// Each principle carries the case that taught it, when there is one: the claim, then the evidence.
const caseFor = (i: number) => CASES.items.find((c) => c.principle === i);
---

<NightPage title="About · Juan Kok" description={PROFILE.role_line}>
  <NightNav current="about" />
  <main class="nt-wrap about">
    <a class="back" href="/">← Back to the landing page</a>
    <header class="head">
      <p class="meta">about</p>
      <h1>About Juan</h1>
      <p class="excerpt">{PROFILE.role_line}</p>
    </header>
    <article class="prose">
      <section id="vault">
        <h2>{VAULT_STATEMENT.title}</h2>
        {VAULT_STATEMENT.paragraphs.map((p) => <p>{p}</p>)}
      </section>

      <section id="thinking">
        <h2>How I think</h2>
        <p class="lead">{THINKING.title} {THINKING.accent}</p>
        <p>{THINKING.body}</p>
        {THINKING.principles.map((p, i) => {
          const c = caseFor(i);
          return (
            <>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
              {c ? (
                <details class="case">
                  <summary>The case: {c.title}</summary>
                  <p><span class="beat">The obvious fix</span>{c.noticed}</p>
                  <p><span class="beat">What I did</span>{c.did}</p>
                </details>
              ) : null}
            </>
          );
        })}

        <h3>{THINKING.ready.title}</h3>
        <ol>{THINKING.ready.points.map((p) => <li>{p}</li>)}</ol>

        <h3>{THINKING.lessons.title}</h3>
        <table class="lessons">
          <thead>
            <tr><th scope="col">In silicon</th><th scope="col">In AI systems</th></tr>
          </thead>
          <tbody>
            {THINKING.lessons.rows.map(([chip, ai]) => (
              <tr><td>{chip}</td><td>{ai}</td></tr>
            ))}
          </tbody>
        </table>
      </section>

      <section id="experience">
        <h2>Experience</h2>
        <ExperienceTimeline roles={PROFILE.experience} cv={cv} />
      </section>
    </article>
  </main>
  <Repos />
  <NightFooter />
</NightPage>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-10);
    max-width: var(--pr-guide-w);
    padding-top: var(--nt-section-y-tight);
  }

  .back,
  .meta,
  .beat,
  summary {
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-caption);
    color: var(--nt-ink-muted);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: var(--hf-space-5);
  }

  .meta {
    margin: 0;
    color: var(--nt-signal-text);
  }

  h1 {
    font-size: var(--nt-fs-h1);
    line-height: var(--nt-lh-tight);
    letter-spacing: var(--nt-tracking-display);
  }

  .excerpt,
  .lead {
    font-size: var(--nt-fs-intro);
    color: var(--nt-ink-soft);
  }

  section {
    scroll-margin-top: var(--hf-space-20);
  }

  /* The prose rhythm (night-prose.css) spaces the article's children; the sections keep it inside. */
  section > * + *,
  .case > * + * {
    margin-top: var(--hf-space-5);
  }

  section > h2:first-child {
    margin-top: 0;
  }

  section + section {
    margin-top: var(--hf-space-14);
  }

  .beat {
    display: block;
    margin-bottom: var(--hf-space-1);
  }

  /* A case sits under the principle it proved, closed until asked for. */
  .case {
    margin: 0 0 var(--hf-space-5);
    padding: 0 var(--hf-space-4);
    border-left: 1px solid var(--nt-signal);
  }

  summary {
    display: flex;
    align-items: center;
    min-height: var(--nt-hit);
    color: var(--nt-signal-text);
    cursor: pointer;
  }

  .lessons {
    width: 100%;
    border-collapse: collapse;
  }

  .lessons th,
  .lessons td {
    padding: var(--hf-space-3) var(--hf-space-4) var(--hf-space-3) 0;
    border-bottom: 1px solid var(--nt-line);
    text-align: left;
    vertical-align: top;
  }

  .lessons th {
    font-family: var(--nt-mono);
    font-size: var(--nt-fs-caption);
    font-weight: normal;
    color: var(--nt-ink-muted);
  }
</style>
