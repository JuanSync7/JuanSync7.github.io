---
import PaperLayout from '../layouts/PaperLayout.astro';
import PaperNav from '../components/layout/PaperNav.astro';
import PaperFooter from '../components/layout/PaperFooter.astro';
import PaperHero from '../components/home/PaperHero.astro';
import SystemMap from '../components/home/SystemMap.astro';
import PaperThinking from '../components/home/PaperThinking.astro';
import PaperCases from '../components/home/PaperCases.astro';
import PaperExperience from '../components/home/PaperExperience.astro';
import Repos from '../components/home/Repos.astro';
import PaperContact from '../components/home/PaperContact.astro';
import { IDENTITY } from '../data/site';
---

<PaperLayout title={`Juan Kok · ${IDENTITY.title}`}>
  <PaperNav />
  <main>
    <PaperHero />
    <SystemMap />
    <PaperThinking />
    <PaperCases />
    <PaperExperience />
    <Repos />
    <PaperContact />
  </main>
  <PaperFooter />
</PaperLayout>
