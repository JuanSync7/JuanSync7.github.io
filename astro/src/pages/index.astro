---
import NightLayout from '../layouts/NightLayout.astro';
import NightNav from '../components/layout/NightNav.astro';
import NightFooter from '../components/layout/NightFooter.astro';
import HomeHero from '../components/home/HomeHero.astro';
import SystemMap from '../components/home/SystemMap.astro';
import Thinking from '../components/home/Thinking.astro';
import Cases from '../components/home/Cases.astro';
import Experience from '../components/home/Experience.astro';
import Repos from '../components/home/Repos.astro';
import Contact from '../components/home/Contact.astro';
import { IDENTITY } from '../data/site';
---

<NightLayout title={`Juan Kok · ${IDENTITY.title}`}>
  <NightNav />
  <main>
    <HomeHero />
    <SystemMap />
    <Thinking />
    <Cases />
    <Experience />
    <Repos />
    <Contact />
  </main>
  <NightFooter />
</NightLayout>
