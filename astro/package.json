{
  "name": "juansync7-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run slides:export",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "check": "astro check && npm run lint && prettier --check src/figures && npm run figures:check && npm run posts:check && npm run map:check && npm run lessons:selftest && npm run lessons:check && npm run vault:check && npm run presentation:check",
    "map:check": "node scripts/system-map/check.mjs",
    "figure": "node scripts/figures/figure.mjs",
    "figure:seeds": "node scripts/figures/seeds.mjs",
    "figures:check": "node scripts/figures/check.mjs",
    "figures:look": "node scripts/figures/look.mjs",
    "figures:audit": "node scripts/figures/check.mjs && node scripts/figures/look.mjs",
    "figures:selftest": "node scripts/figures/check.mjs --selftest && node scripts/figures/look.mjs --selftest --no-sheet",
    "tabletop:check": "npm run rooms:lighting && npm run rooms:camera && npm run rooms:supports && npm run rooms:depth && node scripts/figures/tabletop-check.mjs",
    "tabletop:browser": "node scripts/figures/tabletop-browser.mjs --appearance",
    "format:figures": "prettier --write src/figures",
    "posts:check": "node scripts/posts/check.mjs",
    "posts:selftest": "node scripts/posts/check.mjs --selftest",
    "lessons:sync": "node scripts/lessons/sync.mjs",
    "lessons:selftest": "node scripts/lessons/sync.mjs --selftest",
    "lessons:check": "node scripts/lessons/check.mjs",
    "lessons:browser": "node scripts/lessons/browser-check.mjs",
    "slides:export": "python3 scripts/slides/check-source.py && node scripts/slides/export.mjs",
    "slides:check": "npm run slides:structure && npm run slides:import -- --check && python3 scripts/slides/check-source.py && node scripts/slides/check.mjs && python3 scripts/slides/check-zip.py",
    "slides:browser": "node scripts/slides/browser-check.mjs",
    "hardware:export": "node scripts/hardware/export.mjs",
    "hardware:check": "node scripts/hardware/check.mjs",
    "hardware:browser": "node scripts/hardware/browser-check.mjs",
    "hardware:verify": "node scripts/hardware/verify.mjs",
    "hardware:archive": "node scripts/hardware/archive.mjs",
    "rooms:materials": "node scripts/figures/room-material-check.mjs",
    "rooms:colour": "node scripts/figures/room-colour-browser.mjs",
    "rooms:gallery": "node scripts/figures/room-gallery.mjs",
    "rooms:verify": "node scripts/figures/room-verify.mjs",
    "rooms:program": "node scripts/figures/room-program-check.mjs",
    "rooms:supports": "node scripts/figures/room-support-regression.mjs",
    "rooms:camera": "node scripts/figures/room-camera-check.mjs",
    "rooms:depth": "node scripts/figures/room-depth-check.mjs",
    "vault:search": "node scripts/vault/search-check.mjs",
    "vault:diagrams": "node scripts/vault/export.mjs --check && node scripts/vault/diagram-check.mjs",
    "vault:diagrams:build": "node scripts/vault/export.mjs",
    "vault:check": "npm run vault:search && npm run vault:diagrams",
    "vault:page": "node scripts/vault/page-check.mjs",
    "slides:import": "node scripts/slides/import.mjs",
    "slides:proof": "python3 scripts/slides/check-source.py && node scripts/slides/export.mjs --proof",
    "slides:find": "node scripts/slides/find.mjs",
    "slides:add": "python3 scripts/slides/kernel/add.py",
    "slides:guard": "python3 scripts/slides/checks/guard.py",
    "slides:structure": "node scripts/slides/checks/structure.mjs && node scripts/slides/checks/discovery.mjs",
    "slides:selftest": "node scripts/slides/checks/selftest.mjs && python3 scripts/slides/checks/guard.py --selftest",
    "slides:extension": "python3 scripts/slides/checks/extensibility.py",
    "slides:eval-check": "node scripts/slides/evals/check-report.mjs",
    "slides:brief": "node scripts/slides/brief.mjs",
    "presentation:check": "node scripts/presentation/check.mjs",
    "presentation:selftest": "node scripts/presentation/check.mjs --selftest",
    "presentation:page": "node scripts/presentation/check.mjs --built",
    "presentation:browser": "node scripts/presentation/browser-check.mjs",
    "voxel:check": "node scripts/voxel/agent.mjs check",
    "voxel:browser": "node scripts/voxel/browser.mjs",
    "slides:use": "node scripts/slides/use.mjs",
    "slides:reuse-check": "python3 scripts/slides/checks/reuse.py",
    "cabinet:poster": "node scripts/presentation/cabinet-poster.mjs",
    "voxel:agent": "node scripts/voxel/agent.mjs",
    "voxel:gpu": "node scripts/voxel/gpu-check.mjs",
    "voxel:gallery": "node scripts/voxel/gallery.mjs --all-models",
    "voxel:vault-check": "node scripts/voxel/vault-selftest.mjs",
    "voxel:stress": "node scripts/voxel/stress.mjs",
    "voxel:island-check": "node scripts/voxel/island-check.mjs",
    "voxel:island-browser": "node scripts/voxel/island-browser.mjs",
    "deepdive:check": "node scripts/deepdive/check.mjs",
    "deepdive:selftest": "node scripts/deepdive/selftest.mjs",
    "deepdive:browser": "node scripts/deepdive/browser.mjs",
    "deepdive:gallery": "node scripts/deepdive/gallery.mjs",
    "deepdive:agent": "node scripts/deepdive/agent.mjs",
    "rooms:lighting": "node scripts/figures/room-lighting-check.mjs",
    "rooms:variation": "node scripts/figures/room-variation-browser.mjs",
    "voxel:atmosphere-check": "node scripts/voxel/web-design-workflow.mjs && node scripts/voxel/atmosphere-check.mjs",
    "voxel:atmosphere-browser": "node scripts/voxel/atmosphere-browser.mjs",
    "voxel:atmosphere-verify": "node scripts/voxel/verify-atmosphere.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^3.1.0",
    "@astrojs/react": "^3.6.0",
    "@astrojs/rss": "^4.0.12",
    "astro": "^4.16.0",
    "gsap": "^3.15.1",
    "mermaid": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "ajv": "8.20.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.5.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-mdx": "^3.0.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-mdxjs": "^3.0.0",
    "playwright": "^1.56.1",
    "pngjs": "^7.0.0",
    "prettier": "3.8.3",
    "svg-path-properties": "2.0.0",
    "svgpath": "2.6.0",
    "typescript": "~5.5.3",
    "typescript-eslint": "^8.59.1",
    "yaml": "^2.8.3"
  }
}
